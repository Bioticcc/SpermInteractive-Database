# rsconnect deployment ignore rules (applies only to shinyapps.io bundles)

# Big raw Seurat objects (we deploy a slim, no-counts version instead)
final_staged_object.rds
final_staged_object_slim.rds
final_staged_object_slim_nocounts.rds
specificCellID*.rds

# New subset Seurat objects (raw) - assets are generated into sc4–sc7 files.
02_Sertoli.rds
03_Spermatogonia_original.rds
04_Spermatocyte_updated.rds
05_Spermatid.rds

# Disabled datasets for launch build
sc1*
sc2*

# Reference/archive artifacts
archive/

# Browser network/profile captures accidentally copied into www/
www/*.har
www/*.json.gz
www/* profile.json/

# Local deployment metadata
rsconnect/

# Windows ADS artifacts
*:Zone.Identifier
