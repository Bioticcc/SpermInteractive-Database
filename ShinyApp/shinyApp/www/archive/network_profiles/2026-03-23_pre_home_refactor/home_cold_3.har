ass=\"ra-field-checkbox\">\n                        <div class=\"form-group shiny-input-container\">\n                          <div class=\"checkbox\">\n                            <label>\n                              <input id=\"sc7d1col\" type=\"checkbox\" class=\"shiny-input-checkbox\"/>\n                              <span>Cluster columns (samples)</span>\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"ra-card ra-plot glass-card legacy-plots\">\n                    <div class=\"ra-card-head\">\n                      <div class=\"ra-head-main\">\n                        <h3 class=\"ra-title\">Spermatid Subset Bubbleplot / Heatmap</h3>\n                      </div>\n                      <p class=\"ra-sub\">Visualise averaged expression across groups and export the figure.</p>\n                    </div>\n                    <div class=\"ra-rowgroup\">\n                      <h4>\n                        <div id=\"sc7d1oupTxt\" class=\"shiny-html-output\"></div>\n                      </h4>\n                      <div class=\"ra-plot-holder\">\n                        <div id=\"sc7d1oup.ui\" class=\"shiny-html-output\"></div>\n                      </div>\n                      <div class=\"ra-download-row\">\n                        <div class=\"ra-download-buttons\">\n                          <a id=\"sc7d1oup.pdf\" class=\"btn btn-default shiny-download-link disabled\" href=\"\" target=\"_blank\" download aria-disabled=\"true\" tabindex=\"-1\">\n                            <i class=\"fas fa-download\" role=\"presentation\" aria-label=\"download icon\"></i>\n                            Download PDF\n                          </a>\n                          <a id=\"sc7d1oup.png\" class=\"btn btn-default shiny-download-link disabled\" href=\"\" target=\"_blank\" download aria-disabled=\"true\