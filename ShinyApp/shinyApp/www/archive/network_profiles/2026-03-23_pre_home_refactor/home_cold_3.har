                          <input type=\"radio\" name=\"sc4a3ord2\" value=\"Original\"/>\n                                <span>Original</span>\n                              </label>\n                              <label class=\"radio-inline\">\n                                <input type=\"radio\" name=\"sc4a3ord2\" value=\"Random\"/>\n                                <span>Random</span>\n                              </label>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div class=\"ra-pane legacy-pane sc4-gene-gene\">\n                  <div class=\"ra-card ra-controls glass-card legacy-controls\">\n                    <div class=\"ra-card-head\">\n                      <div class=\"ra-head-main\">\n                        <h3 class=\"ra-title\">Sertoli Subset Controls</h3>\n                      </div>\n                      <p class=\"ra-sub\">Configure axes, cell subsets, and gene overlays.</p>\n                    </div>\n                    <p class=\"ra-subtext\">Visualise two gene expression signals on the same embedding.</p>\n                    <div class=\"ra-rowgroup\">\n                      <div class=\"ra-rowtitle\">Dimension reduction</div>\n                      <div class=\"ra-field\">\n                        <label class=\"ra-label\">X-axis</label>\n                        <div class=\"form-group shiny-input-container\">\n                          <label class=\"control-label shiny-label-null\" for=\"sc4a3drX\" id=\"sc4a3drX-label\"></label>\n                          <div>\n                            <select id=\"sc4a3drX\" class=\"shiny-input-select\"><option value=\"UMAP1\" selected>UMAP1</option>\n<option value=\"UMAP2\">UMAP2</option>\n<option value=\"tSNE1\">tSNE1</option>\n<option value=\"tSNE2\">tSNE2</option>\n<option value=\"PC1\">PC1</option>\n<option val