            "text": "/* Table Styling */\n.dataTable, .table {\n  border-radius: 8px;\n  overflow: hidden;\n  background-color: white;\n}\n\nhtml[data-theme='dark'] .dataTable,\nhtml[data-theme='dark'] .table {\n  background-color: rgba(15,16,26,0.9);\n  color: var(--color-text);\n}\n\nhtml[data-theme='dark'] table.dataTable thead th,\nhtml[data-theme='dark'] table.dataTable thead td {\n  background: rgba(15, 23, 42, 0.95);\n  color: var(--color-text);\n  border-bottom: 1px solid var(--color-control-border);\n}\n\nhtml[data-theme='dark'] table.dataTable tbody td {\n  background: rgba(10, 15, 30, 0.85);\n  color: var(--color-text);\n  border-color: rgba(99, 102, 241, 0.2);\n}\n\nhtml[data-theme='dark'] .dataTables_wrapper .dataTables_filter input,\nhtml[data-theme='dark'] .dataTables_wrapper .dataTables_length select {\n  background: var(--color-input-bg);\n  color: var(--color-text);\n  border: 1px solid var(--color-control-border);\n}\n\nhtml[data-theme='dark'] .dataTables_wrapper .dataTables_info,\nhtml[data-theme='dark'] .dataTables_wrapper .dataTables_paginate {\n  color: var(--color-text);\n}\n\nhtml[data-theme='dark'] .dataTables_wrapper .paginate_button {\n  background: rgba(12, 18, 32, 0.9) !important;\n  color: var(--color-text) !important;\n  border: 1px solid var(--color-control-border) !important;\n  box-shadow: 0 8px 18px rgba(2, 6, 23, 0.55);\n}\n\nhtml[data-theme='dark'] .dataTables_wrapper .paginate_button.current,\nhtml[data-theme='dark'] .dataTables_wrapper .paginate_button:hover {\n  background: rgba(79, 70, 229, 0.25) !important;\n  color: var(--color-text) !important;\n  border-color: var(--color-control-border-strong) !important;\n}\n\n/* Apply gradient to entire HTML background */\nhtml {\n  height: 100%;\n}\n\nbody {\n  min-height: 100vh;\n  margin: 0;\n  padding: 0;\n  background: linear-gradient(\n    to bottom right,\n    var(--color-html-bg-1),\n    var(--color-html-bg-2),\n    var(--color-html-bg-3)\n  );\n  background-attachment: fixed; /* optional, locks gradient to viewport */\n  font-family: 'Open Sans', sans-serif;\n  color: var(--color-text);\n}\n\n/* Remove white fill from central content */\n.container, .content, .fluid-page, .well, .panel, .box {\n  background-color: transparent !important;\n  box-shadow: none !important;\n}\n\n/* Shared layout chrome */\n.container, .fluid-page {\n  padding-left: 30px;\n  padding-right: 30px;\n}\n\n.panel, .well, .box, .shiny-input-container {\n  background-color: var(--color-white-translucent) !important;\n  padding: 15px;\n  border-radius: 10px;\n  box-shadow: 0 2px 6px var(--shadow-light);\n}\n\n.navbar-default {\n  border-radius: 10px !important;\n  margin-top: 10px;\n  box-shadow: 0 2px 8px var(--shadow-medium);\n}\n\n.column[style*=\"border-right\"] {\n  border-right: none !important;\n  box-shadow: inset -1px 0 0 var(--shadow-light);\n}\n\n/* Input and type defaults */\nselect, input[type=\"text\"], input[type=\"number\"] {\n  background-color: var(--color-input-bg) !important;\n  border-radius: 8px !important;\n  transition: all 0.2s ease;\n  border: 1px solid var(--color-border);\n}\n\nselect:focus, input:focus {\n  box-shadow: 0 0 0 3px var(--color-focus-shadow-soft);\n}\n\nh1, h2, h3, h4 {\n  font-weight: 600;\n  margin-bottom: 10px;\n  color: var(--color-text);\n}\n\nh4 + br {\n  display: none;\n}\n\nh1 {\n  font-size: 2.2rem;\n  font-weight: 700;\n  color: var(--color-text);\n  margin-bottom: 10px;\n  background: none;\n  padding: 0;\n  border: none;\n  box-shadow: none;\n}\n\na[href*=\"weiyanlab.com\"] {\n  font-size: 1.2rem;\n  background-color: var(--color-link-bg);\n  padding: 8px 14px;\n  border-radius: 12px;\n  display: inline-block;\n  margin-top: 8px;\n  color: var(--color-primary) !important;\n  text-decoration: none;\n  font-weight: 600;\n  box-shadow: 0 2px 6px var(--shadow-light);\n  transition: all 0.2s ease;\n}\n\na[href*=\"weiyanlab.com\"]:hover {\n  background-color: var(--color-link-hover-bg);\n  color: var(--color-link-hover-text) !important;\n  box-shadow: 0 4px 12px var(--shadow-medium);\n}\n\nh4 + br + .fluid-row .action-button {\n  margin-top: 10px !important;\n}\n\nhtml[data-theme='dark'] select,\nhtml[data-theme='dark'] input[type=\"text\"],\nhtml[data-theme='dark'] input[type=\"number\"],\nhtml[data-theme='dark'] input[type=\"search\"],\nhtml[data-theme='dark'] input[type=\"email\"],\nhtml[data-theme='dark'] input[type=\"password\"],\nhtml[data-theme='dark'] input[type=\"url\"],\nhtml[data-theme='dark'] input[type=\"file\"],\nhtml[data-theme='dark'] .form-control,\nhtml[data-theme='dark'] textarea {\n  background-color: var(--color-input-bg) !important;\n  color: var(--color-text);\n  border-color: var(--color-control-border);\n  box-shadow: 0 0 0 1px rgba(2, 6, 23, 0.5) inset;\n}\n\nhtml[data-theme='dark'] select:focus,\nhtml[data-theme='dark'] input:focus,\nhtml[data-theme='dark'] textarea:focus {\n  box-shadow: 0 0 0 3px var(--color-control-border-strong), 0 0 0 1px rgba(2, 6, 23, 0.45) inset;\n}\n\nhtml[data-theme='dark'] .shiny-input-container,\nhtml[data-theme='dark'] .shiny-input-panel {\n  background: rgba(7, 11, 24, 0.9);\n  border: 1px solid var(--color-control-border);\n  box-shadow: 0 18px 36px rgba(2, 6, 23, 0.72);\n}\n\nhtml[data-theme='dark'] .shiny-input-container label,\nhtml[data-theme='dark'] .control-label {\n  color: var(--color-text);\n}\n\nhtml[data-theme='dark'] ::placeholder,\nhtml[data-theme='dark'] ::-webkit-input-placeholder,\nhtml[data-theme='dark'] :-ms-input-placeholder {\n  color: rgba(226, 232, 240, 0.65);\n}\n\n/* === Optional: boost spacing above buttons consistently === */\n.action-button {\n  margin-top: 12px;\n}\n\n/* === Add margin above header box === */\n.header-box {\n  margin-top: 30px;  /* adds room between top and header */\n}\n\n/* === Increase spacing above section headers like \"Dimension Reduction\" === */\nh4 {\n  margin-top: 30px;\n}\n\n\n.navbar-nav > li {\n  margin-right: 0 !important;\n}\n\n\n:root{\n  --nav-total-h: 120px;   /* fallbacks; JS overwrites */\n  --viewport-w: 1000px;\n  --nav-left: 16px;\n  --nav-right: 16px;\n  --nav-width: 800px;\n\n  /* shared glass look variables */\n  --glass-blur: 14px;\n  --glass-top: rgba(255,255,255,0.72);\n  --glass-bot: rgba(255,255,255,0.55);\n}\n\n/* allow full-bleed beyond Bootstrap container if needed */\n.container, .container-fluid { \n  overflow: visible; \n}\n\n/* Glass panel sized to EXACT navbar width & offsets */\n.container .tab-content,\n.container-fluid .tab-content {\n  position: relative;\n\n  /* full-bleed placement using measured navbar metrics */\n  left: 50%;\n  right: 50%;\n  margin-left:  calc(-0.5 * var(--viewport-w) + var(--nav-left));\n  margin-right: calc(-0.5 * var(--viewport-w) + var(--nav-right));\n  width: calc(var(--viewport-w) - var(--nav-left) - var(--nav-right));\n  max-width: none;\n\n  margin-top: 16px;\n  min-height: calc(100vh - var(--nav-total-h) - 32px);\n\n  /* glass look */\n  padding: 18px;\n  background: transparent;\n  border: 1px solid rgba(15,23,42,0.08);\n  border-radius: 16px;\n  box-shadow:\n    0 10px 30px rgba(16,24,40,.08),\n    0 1px 0 rgba(16,24,40,.04) inset;\n}\n\nhtml[data-theme='dark'] .container .tab-content,\nhtml[data-theme='dark'] .container-fluid .tab-content{\n  border-color: rgba(255,255,255,0.08);\n  box-shadow:\n    0 24px 50px rgba(0,0,0,0.7),\n    0 1px 0 rgba(255,255,255,0.04) inset;\n}\n\n/* overlay blur + gradient (matches header box) */\n.container .tab-content::before,\n.container-fluid .tab-content::before {\n  content:\"\";\n  position:absolute; inset:0;\n  border-radius:inherit;\n\n  background: linear-gradient(180deg, var(--glass-top), var(--glass-bot));\n  -webkit-backdrop-filter: blur(var(--glass-blur));\n  backdrop-filter: blur(var(--glass-blur));\n  background-size: 180% 180%;\n  animation: gradientFlow 28s ease-in-out infinite alternate;\n\n  z-index:0;\n}\n\n/* ensure content stays above overlay */\n.container .tab-content > *,\n.container-fluid .tab-content > * { \n  position: relative; \n  z-index: 1; \n}\n\n\n\n\n\n/*------------------*/\n/* ===== Header styles ===== */\n:root{\n  --hdr-radius: 18px;\n  --hdr-pad: clamp(14px, 2.5vw, 22px);\n  --hdr-gap: clamp(14px, 2.4vw, 28px);\n  --hdr-title: clamp(20px, 2.2vw, 30px);\n  --hdr-subtitle: clamp(13px, 1.2vw, 16px);\n  --hdr-fg: #0f172a;           /* slate-900 */\n  --hdr-fg-sub: #5b6475;       /* subtle text */\n  --hdr-grad-a: #7c3aed;       /* violet-600 */\n  --hdr-grad-b: #06b6d4;       /* cyan-500  */\n  --hdr-glass: 14px;\n}\n\n/* outer glass card */\n.hdr-wrap{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap: var(--hdr-gap);\n  padding: var(--hdr-pad);\n  border-radius: var(--hdr-radius);\n  background: linear-gradient(180deg, rgba(255,255,255,.7), rgba(255,255,255,.5));\n  backdrop-filter: blur(var(--hdr-glass));\n  -webkit-backdrop-filter: blur(var(--hdr-glass));\n  box-shadow:\n    0 10px 30px rgba(16,24,40,.08),\n    0 1px 0 rgba(16,24,40,.04) inset;\n  border: 1px solid rgba(15,23,42,.08);\n  position: relative;\n  overflow: hidden;\n}\n\n/* faint top accent line */\n.hdr-wrap::before{\n  content:\"\";\n  position:absolute;\n  inset:0 0 auto 0;\n  height:2px;\n  background: linear-gradient(90deg, transparent, rgba(124,58,237,.35), rgba(6,182,212,.35), transparent);\n  opacity:.8;\n}\n\n/* left block */\n.hdr-text{\n  display:flex;\n  flex-direction:column;\n  gap: 6px;\n  min-width: 0; /* prevent overflow */\n}\n\n.hdr-title{\n  margin:0;\n  line-height:1.15;\n  font-size: var(--hdr-title);\n  font-weight: 750;\n  letter-spacing: .2px;\n  color: var(--hdr-fg);\n  /* gradient accent underline */\n  position: relative;\n}\n.hdr-title::after{\n  content:\"\";\n  position:absolute;\n  left:0; bottom:-10px;\n  width: clamp(120px, 22vw, 260px);\n  height: 3px;\n  border-radius: 999px;\n  background: linear-gradient(90deg, var(--hdr-grad-a), var(--hdr-grad-b));\n  opacity:.85;\n}\n\n/* subtitle */\n.hdr-subtitle{\n  margin: 6px 0 0 0;\n  font-size: var(--hdr-subtitle);\n  color: var(--hdr-fg-sub);\n  font-weight: 500;\n}\n\n.hdr-version{\n  margin: 0;\n  font-size: calc(var(--hdr-subtitle) * 0.85);\n  color: var(--hdr-fg-sub);\n  opacity: 0.9;\n  font-weight: 600;\n  letter-spacing: 0.2px;\n}\n\n/* right: logo button */\n.hdr-logo{\n  flex: 0 0 auto;\n  display:inline-grid;\n  place-items:center;\n  padding: 6px;\n  border-radius: 16px;\n  transition: transform .25s ease, box-shadow .25s ease, background-color .25s ease;\n  background: rgba(255,255,255,.6);\n  border: 1px solid rgba(15,23,42,.08);\n}\n.hdr-logo img{\n  height: clamp(46px, 6.2vw, 72px);\n  width: auto;\n  display:block;\n  border-radius: 14px;\n  box-shadow: 0 2px 8px rgba(0,0,0,.06);\n}\n\n/* hover/focus delight */\n.hdr-logo:hover,\n.hdr-logo:focus-visible{\n  transform: translateY(-1px);\n  box-shadow:\n    0 14px 36px rgba(124,58,237,.18),\n    0 0 0 3px rgba(124,58,237,.15);\n  background: linear-gradient(180deg, rgba(255,255,255,.85), rgba(255,255,255,.6));\n  outline: none;\n}\n\nhtml[data-theme='dark'] .hdr-wrap{\n  background: linear-gradient(180deg, rgba(24,26,39,.94), rgba(13,15,24,.92));\n  border: 1px solid rgba(255,255,255,.08);\n  box-shadow:\n    0 20px 46px rgba(0,0,0,.65),\n    0 1px 0 rgba(255,255,255,.06) inset;\n}\n\nhtml[data-theme='dark'] .hdr-wrap::before{\n  background: linear-gradient(90deg, transparent, rgba(99,102,241,.5), rgba(20,184,166,.45), transparent);\n}\n\nhtml[data-theme='dark'] .hdr-logo{\n  background: rgba(15,18,28,.92);\n  border-color: rgba(255,255,255,.08);\n}\n\nhtml[data-theme='dark'] .hdr-logo img{\n  box-shadow: 0 6px 18px rgba(0,0,0,.6);\n}\n\nhtml[data-theme='dark'] .hdr-logo:hover,\nhtml[data-theme='dark'] .hdr-logo:focus-visible{\n  background: linear-gradient(180deg, rgba(36,38,52,.96), rgba(18,20,32,.92));\n  box-shadow:\n    0 18px 38px rgba(14,165,233,.3),\n    0 0 0 3px rgba(79,70,229,.35);\n}\n\n.hdr-actions{\n  display:flex;\n  align-items:center;\n  gap: 18px;\n  flex-wrap: wrap;\n  justify-content:flex-end;\n}\n.hdr-title-wrap{\n  display:flex;\n  align-items:center;\n  gap:10px;\n  flex-wrap:wrap;\n}\n.hdr-copy-link{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  width:34px;\n  height:34px;\n  border-radius:50%;\n  background: rgba(79,70,229,0.15);\n  color: inherit;\n  text-decoration:none;\n  opacity:0.65;\n  transition: opacity .15s ease, background .15s ease;\n}\n.hdr-copy-link .fa{\n  font-size:15px;\n}\n.hdr-copy-link:hover,\n.hdr-copy-link:focus-visible{\n  opacity:1;\n  background: rgba(79,70,229,0.25);\n  text-decoration:none;\n}\n.ra-reference{\n  margin: 8px 0 12px;\n  border: 1px solid var(--color-border, rgba(148,163,184,0.25));\n  border-radius: 10px;\n  padding: 10px 12px;\n  background: var(--color-white-translucent, rgba(255,255,255,0.75));\n}\n.ra-reference summary{\n  cursor:pointer;\n  font-weight:600;\n  color: var(--color-primary, #4A90E2);\n  outline:none;\n}\n.ra-reference[open] summary{\n  margin-bottom:8px;\n}\n.ra-reference-img{\n  width:100%;\n  max-width:420px;\n  border-radius:8px;\n  border:1px solid rgba(0,0,0,0.08);\n  display:block;\n  margin-bottom:6px;\n}\n.ra-reference-caption{\n  font-size:13px;\n  color: var(--color-text, #475569);\n  margin:0;\n}\n\n.theme-toggle{\n  display:flex;\n  align-items:center;\n  gap: 10px;\n  flex-wrap: wrap;\n  justify-content:flex-end;\n}\n.shiny-spinner-overlay{\n  background: var(--spinner-bg) !important;\n  backdrop-filter: blur(2px);\n  transition: background .2s ease;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n}\n.shiny-spinner-overlay [class*=\"lds\"] div,\n.shiny-spinner-overlay [class^=\"lds\"] div,\n.shiny-spinner-overlay .spinner-border,\n.shiny-spinner-overlay .spinner-border::after{\n  background: var(--spinner-color) !important;\n  border-color: var(--spinner-color) !important;\n}\n\n.shiny-spinner-overlay::after{\n  content: \"Figures are loading, please wait\";\n  font-size: 16px;\n  font-weight: 600;\n  color: var(--color-text, #1f2937);\n}\n\n.shiny-spinner-overlay::before{\n  content: \"\";\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  border: 4px solid rgba(74, 144, 226, 0.28);\n  border-top-color: var(--spinner-color);\n  background: #ffffff;\n  animation: spinner-ring-spin 0.9s linear infinite;\n}\n\nhtml[data-theme='dark'] .shiny-spinner-overlay::after{\n  color: #e2e8f0;\n}\n\nhtml[data-theme='dark'] .shiny-spinner-overlay::before{\n  border-color: rgba(148, 163, 184, 0.32);\n  border-top-color: var(--spinner-color);\n  background: #020617;\n}\n\n.shiny-spinner-overlay [class*=\"lds\"],\n.shiny-spinner-overlay [class^=\"lds\"],\n.shiny-spinner-overlay .spinner-border{\n  display: none !important;\n}\n\n@keyframes spinner-ring-spin {\n  from { transform: rotate(0deg); }\n  to { transform: rotate(360deg); }\n}\n\nhtml[data-theme='dark'] .shiny-notification {\n  background: rgba(12, 18, 32, 0.96);\n  color: var(--color-text);\n  border: 1px solid var(--color-control-border);\n  box-shadow: 0 18px 40px rgba(2, 6, 23, 0.75);\n}\n\nhtml[data-theme='dark'] .shiny-notification .close {\n  color: var(--color-text);\n  opacity: 0.7;\n}\n\n.theme-toggle-input{\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  border: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n.theme-toggle-label{\n  display:flex;\n  align-items:center;\n  gap: 10px;\n  padding: 6px 12px;\n  border-radius: 999px;\n  background: rgba(255,255,255,.65);\n  border: 1px solid rgba(15,23,42,.12);\n  cursor: pointer;\n  transition: background .25s ease, border-color .25s ease, box-shadow .25s ease;\n  font-weight: 600;\n  color: var(--color-text);\n}\n\n.theme-toggle-label:hover{\n  border-color: rgba(15,23,42,.3);\n}\n\n.theme-toggle-input:focus-visible + .theme-toggle-label{\n  box-shadow: 0 0 0 3px var(--color-focus-shadow);\n}\n\n.theme-toggle-track{\n  width: 42px;\n  height: 22px;\n  border-radius: 999px;\n  background: rgba(15,23,42,.2);\n  position: relative;\n  transition: background .25s ease;\n}\n\n.theme-toggle-thumb{\n  position: absolute;\n  top: 3px;\n  left: 3px;\n  width: 16px;\n  height: 16px;\n  border-radius: 999px;\n  background: var(--color-primary);\n  box-shadow: 0 2px 6px rgba(15,23,42,.3);\n  transition: transform .25s ease, background .25s ease;\n}\n\n.theme-toggle-input:checked + .theme-toggle-label .theme-toggle-thumb{\n  transform: translateX(20px);\n  background: #facc15;\n}\n\n.theme-toggle-input:checked + .theme-toggle-label .theme-toggle-track{\n  background: rgba(250,204,21,.35);\n}\n\n.theme-toggle-icon{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  line-height: 1;\n  color: var(--color-text);\n}\n\n.theme-toggle-icon .fa{\n  font-size: 0.9rem;\n}\n\nhtml[data-theme='dark'] .theme-toggle-label{\n  background: linear-gradient(135deg, rgba(12,21,45,0.95), rgba(7,12,24,0.9));\n  border-color: var(--color-control-border);\n  color: var(--color-text);\n  box-shadow: 0 14px 32px rgba(2,6,23,0.8);\n}\n\nhtml[data-theme='dark'] .theme-toggle-track{\n  background: rgba(26,48,96,0.85);\n}\n\nhtml[data-theme='dark'] .theme-toggle-input:checked + .theme-toggle-label .theme-toggle-track{\n  background: linear-gradient(90deg, rgba(33,74,158,0.9), rgba(44,102,180,0.85));\n}\n\nhtml[data-theme='dark'] .theme-toggle-thumb{\n  background: var(--color-primary-hover);\n  box-shadow: 0 2px 8px rgba(2,6,23,0.8);\n}\n\nhtml[data-theme='dark'] .theme-toggle-input:checked + .theme-toggle-label .theme-toggle-thumb{\n  background: #5b8dff;\n}\n\n/* subtle animated shimmer across the card (very faint) */\n@keyframes shimmer {\n  0%   { transform: translateX(-120%); }\n  100% { transform: translateX(220%); }\n}\n\n@keyframes gradientFlow {\n  0%   { background-position: 0% 0%; }\n  50%  { background-position: 50% 100%; }\n  100% { background-position: 0% 0%; }\n}\n\n@keyframes auroraDrift {\n  0%   { transform: translate3d(-8%, -6%, 0) scale(1); opacity: 0.28; }\n  40%  { transform: translate3d(6%, 4%, 0) scale(1.06); opacity: 0.38; }\n  70%  { transform: translate3d(-4%, 6%, 0) scale(1.03); opacity: 0.32; }\n  100% { transform: translate3d(8%, -2%, 0) scale(1.05); opacity: 0.26; }\n}\n.hdr-wrap::after{\n  content:\"\";\n  position:absolute;\n  top:0; bottom:0;\n  width: 35%;\n  pointer-events:none;\n  background: linear-gradient(90deg, transparent, rgba(255,255,255,.25), transparent);\n  filter: blur(8px);\n  animation: shimmer 6.5s ease-in-out infinite;\n  opacity: .35;\n}\n\n/* responsiveness */\n@media (max-width: 820px){\n  .hdr-wrap{\n    flex-direction:column;\n    align-items:flex-start;\n  }\n  .hdr-title::after{ bottom:-8px; }\n  .hdr-logo{ align-self:flex-end; }\n}\n\n@media (max-width: 520px){\n  .hdr-wrap{ gap: 12px; }\n  .hdr-logo img{ height: 56px; }\n}\n\n\n"
