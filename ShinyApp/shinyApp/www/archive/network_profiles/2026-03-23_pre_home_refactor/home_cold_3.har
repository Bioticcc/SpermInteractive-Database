AP2\" selected>UMAP2</option>\n<option value=\"tSNE1\">tSNE1</option>\n<option value=\"tSNE2\">tSNE2</option>\n<option value=\"PC1\">PC1</option>\n<option value=\"PC2\">PC2</option>\n<option value=\"PC3\">PC3</option>\n<option value=\"PC4\">PC4</option>\n<option value=\"PC5\">PC5</option></select>\n                            <script type=\"application/json\" data-for=\"sc6a3drY\" data-nonempty=\"\">{\"plugins\":[\"selectize-plugin-a11y\"]}</script>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div class=\"ra-rowgroup\">\n                      <div class=\"ra-rowtitle\">Gene expression overlay</div>\n                      <div class=\"ra-field\">\n                        <label class=\"ra-label\">Gene name</label>\n                        <div class=\"shinyhelper-wrapper\">\n                          <div class=\"form-group shiny-input-container\">\n                            <label class=\"control-label shiny-label-null\" for=\"sc6a3inp1\" id=\"sc6a3inp1-label\"></label>\n                            <div>\n                              <select class=\"shiny-input-select form-control\" id=\"sc6a3inp1\"></select>\n                              <script type=\"application/json\" data-for=\"sc6a3inp1\">{\"placeholder\":\"Type a gene name\",\"plugins\":[\"selectize-plugin-a11y\"]}</script>\n                            </div>\n                          </div>\n                          <div class=\"shinyhelper-container\">\n                            <i class=\"far fa-circle-question shinyhelper-icon\" role=\"presentation\" aria-label=\"circle-question icon\" data-modal-size=\"m\" data-modal-type=\"inline\" data-modal-title=\"Gene expression to colour cells by\" data-modal-content=\"Select gene to colour cells by gene expression&lt;br&gt;- Gene expression are coloured in a White-Red colour scheme which can be changed in the plot controls\" data-modal-label=\"Okay\" data-modal-easyclose=\"TRUE\" data-modal-fade=\"TRUE\"></i>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div class=\"ra-rowgroup\">\n                      <div class=\"ra-rowtitle\">Gene expression 2 overlay</div>\n                      <div class=\"ra-field\">\n                        <label class=\"ra-label\">Gene name</label>\n                        <div class=\"shinyhelper-wrapper\">\n                          <div class=\"form-group shiny-input-container\">\n                            <label class=\"control-label shiny-label-null\" for=\"sc6a3inp2\" id=\"sc6a3inp2-label\"></label>\n                            <div>\n                              <select class=\"shiny-input-select form-control\" id=\"sc6a3inp2\"></select>\n                              <script type=\"application/json\" data-for=\"sc6a3inp2\">{\"placeholder\":\"Type a gene name\",\"plugins\":[\"selectize-plugin-a11y\"]}</script>\n                            </div>\n                          </div>\n                          <div class=\"shinyhelper-container\">\n                            <i class=\"far fa-circle-question shinyhelper-icon\" role=\"presentation\" aria-label=\"circle-question icon\" data-modal-size=\"m\" data-modal-type=\"inline\" data-modal-title=\"Gene expression to colour cells by\" data-modal-content=\"Select gene to colour cells by gene expression&lt;br&gt;- Gene expression are coloured in a White-Red colour scheme which can be changed in the plot controls\" data-modal-label=\"Okay\" data-modal-easyclose=\"TRUE\" data-modal-fade=\"TRUE\"></i>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"ra-card ra-plot glass-card legacy-plots\">\n                    <div class=\"ra-card-head\">\n                      <div class=\"ra-head-main\">\n                