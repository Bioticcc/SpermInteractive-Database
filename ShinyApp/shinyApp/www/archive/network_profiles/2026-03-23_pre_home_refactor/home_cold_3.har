            "mimeType": "text/css; charset=utf-8",
            "size": 1578,
            "text": "/**\n * Note that this CSS is shared by both the variant parameters form and shiny apps!\n */\n\n.shiny-server-account {\n  display: none;\n  position: absolute;\n  top: 0;\n  right: 0;\n  width: auto;\n  height: auto;\n  background-color: #E0E0E0;\n  padding: 3px 8px;\n  font-size: 12px;\n}\n.shiny-server-account a {\n  display: inline-block;\n  margin-left: 3px;\n}\n.shiny-server-expired {\n  position: fixed;\n  display: block;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: auto;\n  background-color: #E11;\n  color: white;\n  font-weight: bold;\n  text-shadow: #333 1px 1px 1px;\n  text-align: center;\n  padding: 8px;\n}\nbody.ss-reconnecting {\n  background: none;\n  opacity: 1;\n}\n\nbody.disconnected {\n  background: none;\n  opacity: 1;\n}\n\n#ss-connect-dialog {\n  opacity: 1 !important;\n  padding: 1em;\n  position: fixed;\n  bottom: 50px;\n  left: -30px;\n  padding-left: 45px;\n  padding-right: 18px;\n  width: 300px;\n  height: auto;\n  z-index: 99999;\n  background-color: #404040;\n  color: white;\n  border-radius: 3px;\n  font-size: 0.9em;\n  box-shadow: rgba(0, 0, 0, 0.3) 3px 3px 10px;\n}\n#ss-connect-dialog label {\n  display: block;\n  font-weight: normal;\n  color: white;\n  margin: 0;\n  padding: 0;\n}\n\n#ss-connect-dialog a, #ss-connect-dialog a:visited {\n  display: block;\n  color: #9999FF;\n  font-weight: bold;\n  margin: 0;\n  padding: 0;\n}\n\n#ss-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  bottom: 0;\n  right: 0;\n  z-index: 99998;\n  overflow: hidden;\n  cursor: progress;\n}\n\n.ss-gray-out {\n  background-color: #999;\n  opacity: 0.7;\n  cursor: not-allowed !important;\n}\n\n#ss-clearfix {\n  clear: both;\n}\n"
