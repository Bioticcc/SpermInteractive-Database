                  </div>\n                      </div>\n                      <div class=\"ra-field-checkbox\">\n                        <div class=\"form-group shiny-input-container\">\n                          <div class=\"checkbox\">\n                            <label>\n                              <input id=\"sc4d1col\" type=\"checkbox\" class=\"shiny-input-checkbox\"/>\n                              <span>Cluster columns (samples)</span>\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"ra-card ra-plot glass-card legacy-plots\">\n                    <div class=\"ra-card-head\">\n                      <div class=\"ra-head-main\">\n                        <h3 class=\"ra-title\">Sertoli Subset Bubbleplot / Heatmap</h3>\n                      </div>\n                      <p class=\"ra-sub\">Visualise averaged expression across groups and export the figure.</p>\n                    </div>\n                    <div class=\"ra-rowgroup\">\n                      <h4>\n                        <div id=\"sc4d1oupTxt\" class=\"shiny-html-output\"></div>\n                      </h4>\n                      <div class=\"ra-plot-holder\">\n                        <div id=\"sc4d1oup.ui\" class=\"shiny-html-output\"></div>\n                      </div>\n                      <div class=\"ra-download-row\">\n                        <div class=\"ra-download-buttons\">\n                          <a id=\"sc4d1oup.pdf\" class=\"btn btn-default shiny-download-link disabled\" href=\"\" target=\"_blank\" download aria-disabled=\"true\" tabindex=\"-1\">\n                            <i class=\"fas fa-download\" role=\"presentation\" aria-label=\"download icon\"></i>\n                            Download PDF\n                          </a>\n                          <a id=\"sc4d1oup.png\" class=\"btn btn-default shiny-download-link disabled\" href=\"\" target=\"_blank\" download aria-disabled=\"true\" tabindex=\"-1\">\n                            <i class=\"fas fa-download\" role=\"presentation\" aria-label=\"download icon\"></i>\n                            Download PNG\n                          </a>\n                        </div>\n                        <div class=\"ra-download-sizing\">\n                          <div class=\"form-group shiny-input-container\" style=\"width:148px;\">\n                            <label class=\"control-label\" id=\"sc4d1oup.h-label\" for=\"sc4d1oup.h\">PDF / PNG height:</label>\n                            <input id=\"sc4d1oup.h\" type=\"number\" class=\"shiny-input-number form-control\" value=\"10\" data-update-on=\"change\" min=\"4\" max=\"20\" step=\"0.5\"/>\n                          </div>\n                          <div class=\"form-group shiny-input-container\" style=\"width:148px;\">\n                            <label class=\"control-label\" id=\"sc4d1oup.w-label\" for=\"sc4d1oup.w\">PDF / PNG width:</label>\n                            <input id=\"sc4d1oup.w\" type=\"number\" class=\"shiny-input-number form-control\" value=\"10\" data-update-on=\"change\" min=\"4\" max=\"20\" step=\"0.5\"/>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div class=\"tab-pane\" data-value=\"sc5_main_figures\" id=\"tab-1316-1\">\n              <div class=\"legacy-stack sc5-mainfig-stack\">\n                <div class=\"legacy-pane mainfig-pane\">\n                  <div class=\"ra-card ra-controls glass-card mainfig-controls\">\n                    <div class=\"ra-card-head\">\n                      <div class=\"ra-head-main\">\n                        <h3 class=\"ra-title\">Spermatogonia Subset Main Figures</h3>\n                      </div>\n                      <p cla