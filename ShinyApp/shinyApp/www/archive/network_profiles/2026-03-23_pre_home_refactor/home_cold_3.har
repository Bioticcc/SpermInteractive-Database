            "text": "/* ===== Global Quicksand Typography ===== */\n\n/* Base body text */\nbody, \nhtml, \n.shiny-app, \n.container-fluid, \n.tab-content {\n  font-family: \"Quicksand\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  font-weight: 400;  /* Regular Quicksand */\n  letter-spacing: 0.2px;\n  line-height: 1.5;\n}\n\n/* Headings */\nh1, .hdr-title {\n  font-weight: 700;   /* Bold Quicksand */\n  letter-spacing: 0.3px;\n}\n\nh2, h3, h4 {\n  font-weight: 600;   /* Semi-bold Quicksand */\n  letter-spacing: 0.25px;\n}\n\n/* Subtitles, muted labels */\n.hdr-subtitle,\np.subtitle, \nsmall, \n.text-muted {\n  font-weight: 500;   /* Medium Quicksand */\n  letter-spacing: 0.2px;\n}\n\n/* Buttons and nav items */\n.btn, \n.navbar, \n.navbar a, \n.navbar-nav li a {\n  font-weight: 600;   /* Semi-bold Quicksand for UI clarity */\n  letter-spacing: 0.25px;\n}\n\n/* Force Quicksand on headings (overrides Bootstrap's Montserrat) */\n:root { --app-font: \"Quicksand\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; }\n\n.hdr-title,\nh1, h2, h3, h4, h5, h6 {\n  font-family: var(--app-font) !important;\n}\n\n/* Keep our intended weights */\n.hdr-title, h1 { font-weight: 700; letter-spacing: 0.3px; }\nh2, h3, h4     { font-weight: 600; letter-spacing: 0.25px; }\n\n\n\n/*--------------------------*/\n/* === Card Stack consistent spacing === */\n\n/* Header bottom spacing */\n.hdr-wrap {\n  margin-bottom: 12px !important;   /* even gap below header */\n}\n\n/* Navbar spacing */\n.bslib-page-navbar .navbar {\n  margin-top: 0 !important;         /* no double-spacing on top */\n  margin-bottom: 12px !important;   /* match header spacing */\n}\n\n/* Main container spacing */\n.container .tab-content,\n.container-fluid .tab-content {\n  margin-top: 0 !important;         /* prevent extra gap */\n}\n\n/* ===== RA DotPlot layout ===== */\n.ra-pane{\n  display: grid;\n  grid-template-columns: 320px 1fr;\n  gap: 16px;\n  align-items: start;\n}\n\n.ra-divider{\n  border: 0;\n  border-top: 1px solid var(--color-control-border);\n  margin: 26px 0 22px;\n  opacity: 0.9;\n}\n\n/* sticky controls so it tracks with scroll a bit */\n.ra-controls{ position: sticky; top: 16px; }\n\n/* shared glass card look (uses your glass vars) */\n.glass-card{\n  border-radius: 16px;\n  background: linear-gradient(180deg, var(--glass-top), var(--glass-bot));\n  -webkit-backdrop-filter: blur(var(--glass-blur));\n  backdrop-filter: blur(var(--glass-blur));\n  background-size: 200% 200%;\n  animation: gradientFlow 38s ease-in-out infinite alternate;\n  border: 1px solid rgba(15,23,42,0.08);\n  box-shadow:\n    0 10px 30px rgba(16,24,40,.08),\n    0 1px 0 rgba(16,24,40,.04) inset;\n  padding: 16px 16px 18px;\n}\n\nhtml[data-theme='dark'] .glass-card,\nhtml[data-theme='dark'] .panel,\nhtml[data-theme='dark'] .well,\nhtml[data-theme='dark'] .box,\nhtml[data-theme='dark'] .shiny-input-container{\n  background: linear-gradient(180deg, rgba(15,22,45,.95), rgba(7,12,24,.94));\n  background-size: 200% 200%;\n  animation: gradientFlow 38s ease-in-out infinite alternate;\n  border: 1px solid var(--color-control-border);\n  box-shadow:\n    0 22px 44px rgba(2,6,23,.8),\n    0 1px 0 rgba(37,56,116,.35) inset;\n}\n\n/* card header */\n.ra-card-head{\n  margin-bottom: 12px;\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.ra-head-main{\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n.ra-head-main .btn{\n  white-space: nowrap;\n}\n.ra-head-main .ra-btn{\n  padding: 4px 12px;\n  font-size: 0.85rem;\n  line-height: 1.3;\n  border-radius: 8px;\n}\n.ra-head-main .ra-title{\n  margin: 0;\n}\n.ra-reload-wrap{\n  width: 100%;\n  display: flex;\n  justify-content: center;\n  margin-top: 2px;\n}\n.ra-reload-wrap .btn{\n  margin: 0 auto;\n}\n.ra-card-download{\n  position: absolute;\n  top: 18px;\n  right: 18px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  z-index: 5;\n}\n\n.reload-btn{\n  padding: 8px 16px !important;\n  background: #2563eb;\n  color: #ffffff;\n  border: 1px solid #1d4ed8;\n  border-radius: 8px;\n  box-shadow: 0 8px 18px rgba(37,99,235,0.25);\n}\nhtml[data-theme='dark'] .reload-btn{\n  background: #3b82f6;\n  border-color: #2563eb;\n  color: #e8f0ff;\n  box-shadow: 0 8px 18px rgba(59,130,246,0.35);\n}\n.ra-card-download .btn{\n  margin: 0;\n}\n.ra-download-btn{\n  background: rgba(255,255,255,0.9);\n  color: var(--hdr-fg, #0f172a);\n  border: 1px solid rgba(15,23,42,0.12);\n  border-radius: 999px;\n  padding: 6px 16px;\n  font-weight: 600;\n  letter-spacing: 0.01em;\n  box-shadow: 0 14px 30px rgba(15,23,42,0.12);\n  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;\n}\n.ra-download-btn:hover,\n.ra-download-btn:focus{\n  background: rgba(255,255,255,0.98);\n  border-color: rgba(15,23,42,0.2);\n  box-shadow: 0 18px 36px rgba(15,23,42,0.16);\n  color: var(--hdr-fg, #0f172a);\n}\nhtml[data-theme='dark'] .ra-download-btn{\n  background: rgba(9,15,32,0.92);\n  border-color: var(--color-control-border);\n  color: var(--color-text);\n  box-shadow: 0 18px 40px rgba(2,6,23,0.85);\n}\nhtml[data-theme='dark'] .ra-download-btn:hover,\nhtml[data-theme='dark'] .ra-download-btn:focus{\n  background: rgba(17,27,54,0.95);\n  border-color: var(--color-control-border-strong);\n  box-shadow: 0 24px 48px rgba(2,6,23,0.9);\n}\n@media (max-width: 700px){\n  .ra-card-download{\n    position: static;\n    justify-content: flex-end;\n    margin-bottom: 8px;\n  }\n}\n\n/* Figure containers */\n.shiny-plot-output{\n  position: relative;\n  background-color: var(--plot-holder-bg, #ffffff);\n  border-radius: 12px;\n  border: 1px solid var(--plot-holder-border, rgba(15,23,42,0.05));\n  transition: background-color 0.25s ease, border-color 0.25s ease;\n  overflow: hidden;\n}\n.shiny-plot-output > img{\n  border-radius: 12px;\n  width: 100% !important;\n  height: 100% !important;\n  object-fit: contain;\n  display: block;\n  background-color: var(--plot-holder-bg, #ffffff) !important;\n}\nhtml[data-theme='dark'] .shiny-plot-output,\nhtml[data-theme='dark'] .shiny-plot-output > img,\nhtml[data-theme='dark'] .plotly,\nhtml[data-theme='dark'] .html-widget,\nhtml[data-theme='dark'] .heatmaply,\nhtml[data-theme='dark'] #spermatogonia_container {\n  filter: none;\n  background-color: var(--plot-holder-bg, #050815) !important;\n  border: 1px solid var(--plot-holder-border, rgba(148, 163, 184, 0.3));\n  border-radius: 12px;\n  color: var(--color-text);\n}\n\n#spermatogonia_container,\n#ra_dotplot_container,\n#ra_lineplot_container,\n#ccc_heatmap_container {\n  position: relative;\n  overflow: hidden;\n  z-index: 0;\n}\n\n#spermatogonia_container > *,\n#ra_dotplot_container > *,\n#ra_lineplot_container > *,\n#ccc_heatmap_container > * {\n  position: relative;\n  z-index: 1;\n}\n\n#spermatogonia_container::after,\n#ra_dotplot_container::after,\n#ra_lineplot_container::after,\n#ccc_heatmap_container::after {\n  content: \"\";\n  position: absolute;\n  inset: -35%;\n  background:\n    radial-gradient(circle at 20% 20%, var(--aurora-a), transparent 65%),\n    radial-gradient(circle at 80% 30%, var(--aurora-b), transparent 70%),\n    radial-gradient(circle at 50% 80%, var(--aurora-c), transparent 75%);\n  mix-blend-mode: screen;\n  pointer-events: none;\n  animation: auroraDrift 18s ease-in-out infinite;\n  opacity: 0.32;\n  z-index: 0;\n}\n\nhtml[data-theme='dark'] #spermatogonia_container,\nhtml[data-theme='dark'] #ra_dotplot_container,\nhtml[data-theme='dark'] #ra_lineplot_container,\nhtml[data-theme='dark'] #ccc_heatmap_container {\n  background: linear-gradient(180deg, rgba(5, 8, 20, 0.94), rgba(10, 12, 24, 0.9)) !important;\n  background-size: 220% 220%;\n  animation: gradientFlow 26s ease-in-out infinite alternate;\n  border: 1px solid rgba(148, 163, 184, 0.2) !important;\n  box-shadow:\n    inset 0 0 0 1px rgba(15, 23, 42, 0.25),\n    0 24px 48px rgba(2, 6, 23, 0.55);\n}\n\nhtml[data-theme='lightblue'] #spermatogonia_container,\nhtml[data-theme='lightblue'] #ra_dotplot_container,\nhtml[data-theme='lightblue'] #ra_lineplot_container,\nhtml[data-theme='lightblue'] #ccc_heatmap_container {\n  background: linear-gradient(180deg, rgba(224, 244, 255, 0.95), rgba(200, 230, 255, 0.92)) !important;\n  background-size: 220% 220%;\n  animation: gradientFlow 26s ease-in-out infinite alternate;\n  border: 1px solid rgba(74, 144, 226, 0.22) !important;\n  box-shadow:\n    inset 0 0 0 1px rgba(74, 144, 226, 0.15),\n    0 18px 36px rgba(15, 23, 42, 0.16);\n}\n\nhtml[data-theme='dark'] #spermatogonia_container::after,\nhtml[data-theme='dark'] #ra_dotplot_container::after,\nhtml[data-theme='dark'] #ra_lineplot_container::after,\nhtml[data-theme='dark'] #ccc_heatmap_container::after {\n  opacity: 0.38;\n  mix-blend-mode: screen;\n}\n\nhtml[data-theme='lightblue'] #spermatogonia_container::after,\nhtml[data-theme='lightblue'] #ra_dotplot_container::after,\nhtml[data-theme='lightblue'] #ra_lineplot_container::after,\nhtml[data-theme='lightblue'] #ccc_heatmap_container::after {\n  opacity: 0.25;\n  mix-blend-mode: soft-light;\n}\n.ra-title{\n  margin: 0;\n  font-weight: 700;\n  font-size: clamp(16px, 1.4vw, 20px);\n  letter-spacing: .3px;\n  color: var(--hdr-fg, #0f172a);\n  position: relative;\n}\n.ra-title::after{\n  content:\"\";\n  position:absolute; left:0; bottom:-8px;\n  width: 140px; height: 3px; border-radius: 999px;\n  background: linear-gradient(90deg, var(--hdr-grad-a,#7c3aed), var(--hdr-grad-b,#06b6d4));\n  opacity:.85;\n}\n.ra-sub{\n  margin: 10px 0 0 0;\n  font-size: 0.95rem;\n  color: var(--hdr-fg-sub, #5b6475);\n  font-weight: 500;\n}\n\n/* fields */\n.ra-field{ margin-top: 14px; }\n.ra-label{\n  display:block;\n  font-weight: 600;\n  font-size: 0.9rem;\n  margin-bottom: 8px;\n  color: #334155;\n}\n\n/* polish selectize + checkboxes a bit */\n.selectize-control .selectize-input{\n  border-radius: 12px;\n  padding: 10px 12px;\n  border: 1px solid rgba(15,23,42,.15);\n  box-shadow: 0 1px 0 rgba(16,24,40,.04) inset;\n}\n.selectize-control .selectize-input.focus{\n  border-color: rgba(79,70,229,.55); /* indigo-ish */\n  box-shadow: 0 0 0 3px rgba(79,70,229,.15);\n}\n\nhtml[data-theme='dark'] .selectize-control .selectize-input,\nhtml[data-theme='dark'] .selectize-dropdown {\n  background-color: var(--color-control-bg);\n  border-color: var(--color-control-border);\n  color: var(--color-text);\n  box-shadow: 0 1px 0 rgba(2,6,23,.45) inset, 0 18px 32px rgba(1,5,15,.7);\n}\n\nhtml[data-theme='dark'] .selectize-control .selectize-input input {\n  color: var(--color-text) !important;\n}\n\nhtml[data-theme='dark'] .selectize-dropdown .option {\n  color: var(--color-text);\n}\n\nhtml[data-theme='dark'] .selectize-control .selectize-input.focus,\nhtml[data-theme='dark'] .selectize-control .selectize-input.dropdown-active {\n  border-color: var(--color-control-border-strong);\n  box-shadow: 0 0 0 3px var(--color-control-border-strong), 0 1px 0 rgba(2,6,23,.45) inset;\n}\n\nhtml[data-theme='dark'] .selectize-dropdown .active {\n  background-color: rgba(35,56,116,.75);\n  color: #f8fafc;\n}\n\nhtml[data-theme='dark'] .selectize-control.multi .selectize-input > .item,\nhtml[data-theme='dark'] .selectize-control.multi .selectize-input > div {\n  background: #000000 !important;\n  color: #ffffff !important;\n  border: 1px solid #1f2937 !important;\n  text-shadow: none !important;\n  box-shadow: none !important;\n}\n\nhtml[data-theme='dark'] .selectize-control.multi .selectize-input > .item .remove,\nhtml[data-theme='dark'] .selectize-control.multi .selectize-input > div .remove {\n  color: #ffffff !important;\n  border-left: 1px solid #1f2937 !important;\n}\n\n/* Cell type checkboxes → two columns */\n.ra-card .shiny-options-group{\n  display: grid;\n  grid-template-columns: 1fr 1fr;  /* two equal columns */\n  gap: 8px 16px;                   /* vertical gap 8px, horizontal gap 16px */\n  padding: 10px 12px;\n  border: 1px solid rgba(15,23,42,.08);\n  border-radius: 12px;\n  background: rgba(255,255,255,.45);\n}\n\n.ra-card .checkbox{\n  margin: 0;\n  display: flex; align-items: center; gap: 8px;\n}\n\nhtml[data-theme='dark'] .ra-card .shiny-options-group,\nhtml[data-theme='dark'] .ra-rowgroup{\n  background: rgba(14,16,24,0.85);\n  border-color: rgba(255,255,255,.08);\n  box-shadow: 0 1px 0 rgba(255,255,255,.04) inset;\n}\n\n/* keep plot area breathing nicely */\n.ra-plot{ padding-top: 12px; }\n\n/* Subtle grouped sections for the three rows */\n.ra-rowgroup{\n  padding: 10px 12px 12px;\n  border: 1px solid rgba(15,23,42,.08);\n  border-radius: 12px;\n  background: rgba(255,255,255,.45);\n  box-shadow: 0 1px 0 rgba(16,24,40,.04) inset;\n  margin-top: 12px;\n}\n\n.ra-rowtitle{\n  margin-bottom: 8px;\n  font-weight: 600;\n  color: #334155;\n}\n\nhtml[data-theme='dark'] .ra-rowtitle,\nhtml[data-theme='dark'] .ra-label,\nhtml[data-theme='dark'] .ra-sub{\n  color: var(--hdr-fg-sub, #cbd5f5);\n}\n\n/* Optional: on narrow screens, stack like DotPlot page */\n@media (max-width: 900px){\n  .ra-controls{ position: static; }\n  .ra-pane{ grid-template-columns: 1fr; }\n}\n\n/* Make multi-select taller & comfy for LR pairs */\n#ccc_lr_select + .selectize-control .selectize-input {\n  min-height: 44px;\n  padding-top: 8px;\n  padding-bottom: 8px;\n}\n\n/* Plotly container: soften default hard edges inside our card */\n.ra-plot .plotly.html-widget, \n.ra-plot .plotly { \n  border-radius: 12px;\n  overflow: hidden; /* clip axes/toolbars corners */\n}\n\n/* Responsive: stack like the other pages */\n@media (max-width: 900px){\n  .ra-controls{ position: static; }\n  .ra-pane{ grid-template-columns: 1fr; }\n}\n\n.legacy-pane{\n  display: grid;\n  grid-template-columns: minmax(280px, 320px) 1fr;\n  gap: 20px;\n  align-items: start;\n}\n\n.mainfig-pane{\n  /* Match the control column height to the plot column and keep the two cards aligned. */\n  align-items: stretch;\n  /* Slightly wider control column so long cell names don't overflow the card. */\n  grid-template-columns: minmax(320px, 380px) 1fr;\n}\n\n.mainfig-controls{\n  overflow: auto;\n}\n\n.mainfig-controls .checkbox label{\n  /* Shiny renders checkbox labels inside a flex row; allow long labels to wrap. */\n  flex: 1 1 auto;\n  min-width: 0;\n  white-space: normal;\n  overflow-wrap: anywhere;\n}\n\n.mainfig-plot-holder{\n  /* The square plot sets its own height via aspect-ratio. */\n  --plot-min-height: 0px;\n}\n\n.mainfig-square{\n  width: 100%;\n  aspect-ratio: 1 / 1;\n}\n\n.mainfig-square .shiny-spinner-output-container,\n.mainfig-square .shiny-spinner-placeholder,\n.mainfig-square .load-container,\n.mainfig-square .shiny-plot-output{\n  width: 100% !important;\n  height: 100% !important;\n}\n\n.mainfig-square .shiny-plot-output > img{\n  width: 100% !important;\n  height: 100% !important;\n}\n\n.legacy-stack{\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n.legacy-advanced{\n  width: 100%;\n}\n\n.legacy-advanced-body{\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16px;\n  align-items: flex-start;\n}\n\n.legacy-advanced .ra-rowgroup{\n  flex: 1 1 280px;\n  padding: 12px 14px 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.legacy-advanced .ra-field{\n  margin-top: 0;\n}\n\n.legacy-advanced .ra-button-row{\n  gap: 10px;\n}\n\n.legacy-advanced .ra-button-row .btn{\n  flex: 0 0 auto;\n  min-width: 160px;\n  padding: 8px 14px;\n}\n\n.legacy-advanced .ra-toggle-btn{\n  width: auto;\n}\n\n.legacy-advanced-toggle{\n  display: flex;\n  align-items: center;\n  margin-bottom: 0;\n}\n\n.ra-advanced-toggle{\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 46px;\n  height: 46px;\n  padding: 10px;\n  border-radius: 999px;\n  font-size: 18px;\n  line-height: 1;\n}\n\n.ra-advanced-toggle .fa{\n  margin: 0;\n}\n\n.legacy-stack .ra-controls,\n.legacy-pane .ra-controls{\n  position: static;\n  top: auto;\n}\n\n@media (max-width: 600px){\n  .legacy-advanced-body{\n    flex-direction: column;\n    gap: 12px;\n  }\n  .legacy-advanced .ra-rowgroup{\n    flex: 1 1 100%;\n  }\n}\n\n.legacy-advanced .shiny-input-container{\n  width: 100%;\n}\n\n.legacy-advanced .checkbox-inline{\n  margin-right: 14px;\n}\n\n.legacy-advanced .checkbox-inline:last-of-type{\n  margin-right: 0;\n}\n\n@media (max-width: 1200px){\n  .legacy-pane{\n    grid-template-columns: minmax(260px, 1fr) 1fr;\n  }\n}\n\n@media (max-width: 980px){\n  .legacy-pane{\n    grid-template-columns: 1fr;\n  }\n}\n\n.legacy-controls .ra-rowgroup,\n.legacy-plots .ra-rowgroup{\n  margin-top: 14px;\n}\n\n.legacy-advanced .ra-rowgroup{\n  margin: 0;\n}\n\n.legacy-advanced-two-col .legacy-advanced-body{\n  display: grid;\n  grid-template-columns: repeat(2, minmax(280px, 1fr));\n  gap: 16px;\n  align-items: flex-start;\n}\n\n.legacy-advanced-two-col .ra-rowgroup{\n  width: 100%;\n  flex: none;\n  padding: 12px 14px 16px;\n  background: rgba(255,255,255,0.65);\n  border: 1px solid rgba(15,23,42,.09);\n  box-shadow: 0 10px 24px rgba(15,23,42,.05);\n}\n\nhtml[data-theme='dark'] .legacy-advanced-two-col .ra-rowgroup{\n  background: rgba(14,16,24,0.9);\n  border-color: rgba(255,255,255,.08);\n  box-shadow: 0 12px 28px rgba(0,0,0,.35);\n}\n\n@media (max-width: 600px){\n  .legacy-advanced-two-col .legacy-advanced-body{\n    grid-template-columns: 1fr;\n    gap: 12px;\n  }\n\n  .legacy-advanced-two-col .ra-rowgroup{\n    width: 100%;\n  }\n}\n\n.legacy-controls .ra-rowgroup:first-of-type,\n.legacy-plots .ra-rowgroup:first-of-type{\n  margin-top: 0;\n}\n\n.legacy-controls .ra-field,\n.legacy-plots .ra-field{\n  margin-top: 12px;\n}\n\n.legacy-controls .ra-field:first-of-type,\n.legacy-plots .ra-field:first-of-type{\n  margin-top: 0;\n}\n\n.ra-subtext{\n  margin: 4px 0 2px;\n  color: rgba(15,23,42,0.75);\n  font-size: 0.95rem;\n}\n\n.ra-button-row{\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 10px;\n}\n\n.ra-button-row .btn{\n  flex: 1 1 auto;\n  min-width: 140px;\n}\n\n.legacy-controls .ra-button-row,\n.legacy-advanced .ra-button-row{\n  justify-content: flex-start;\n}\n\n.legacy-controls .ra-button-row .btn,\n.legacy-advanced .ra-button-row .btn{\n  flex: 0 0 auto;\n}\n\n.ra-toggle-btn{\n  width: 100%;\n  font-weight: 600;\n}\n\n.ra-field-checkbox{\n  margin-top: 12px;\n  display: flex;\n  align-items: center;\n}\n\n.ra-plot-holder{\n  background: var(--plot-holder-bg, #ffffff);\n  padding: 12px;\n  border-radius: 12px;\n  box-shadow: 0 12px 30px rgba(15,23,42,0.06);\n  border: 1px solid var(--plot-holder-border, rgba(15,23,42,0.05));\n  min-height: var(--plot-min-height, 520px);\n}\n\nhtml[data-theme='dark'] .ra-plot-holder{\n  background: var(--plot-holder-bg, var(--color-surface-card-raised, #141f3f));\n  border: 1px solid var(--plot-holder-border, var(--color-control-border));\n  box-shadow: 0 26px 46px rgba(2,6,23,0.85);\n}\n\n.ra-card.ra-plot{\n  min-height: var(--plot-min-height, 520px);\n}\n\n.ra-card.ra-plot .shiny-spinner-output-container,\n.ra-card.ra-plot .shiny-spinner-placeholder,\n.ra-card.ra-plot .shiny-plot-output {\n  min-height: inherit;\n}\n\n#spermatogonia_container,\n#ra_dotplot_container,\n#ra_lineplot_container {\n  min-height: 720px;\n}\n\n.ra-download-row{\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  align-items: center;\n  margin-top: 14px;\n}\n\n.ra-download-buttons{\n  display: flex;\n  gap: 10px;\n}\n\n.ra-download-buttons .btn{\n  min-width: 140px;\n}\n\n.ra-download-sizing{\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.ra-download-sizing .form-group{\n  margin-bottom: 0;\n  flex: 1 1 140px;\n}\n\n.legacy-plots h4{\n  margin-top: 0;\n  font-weight: 600;\n  color: #344055;\n}\n\n.legacy-controls .shiny-input-container{\n  width: 100%;\n}\n\n.legacy-controls textarea.form-control{\n  min-height: 220px;\n  resize: vertical;\n}\n\n.ra-plot-holder .shiny-output-error-validation{\n  margin-top: 8px;\n}\n\n.figure-expl-wrap{\n  width: 100%;\n  margin-top: 16px;\n}\n\n.figure-expl-details{\n  width: 100%;\n}\n\n.figure-expl-details > summary{\n  list-style: none;\n  margin-left: auto;\n  width: fit-content;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  cursor: pointer;\n  padding: 8px 14px;\n  border-radius: 999px;\n  font-weight: 600;\n  color: #1f3b66;\n  background: rgba(79, 70, 229, 0.12);\n  border: 1px solid rgba(79, 70, 229, 0.35);\n}\n\n.figure-expl-details > summary::-webkit-details-marker{\n  display: none;\n}\n\n.figure-expl-details[open] > summary{\n  margin-bottom: 10px;\n}\n\n.figure-expl-card{\n  margin-bottom: 0;\n}\n\nhtml[data-theme='dark'] .figure-expl-details > summary{\n  color: #e2ecff;\n  background: rgba(129, 140, 248, 0.18);\n  border-color: rgba(129, 140, 248, 0.45);\n}\n\nhtml[data-theme='dark'] .figure-expl-details > summary:hover,\nhtml[data-theme='dark'] .figure-expl-details > summary:focus-visible{\n  background: rgba(129, 140, 248, 0.26);\n}\n\nhtml[data-theme='lightblue'] .figure-expl-details > summary:hover,\n.figure-expl-details > summary:hover,\n.figure-expl-details > summary:focus-visible{\n  background: rgba(79, 70, 229, 0.18);\n}\n\n"
          },
