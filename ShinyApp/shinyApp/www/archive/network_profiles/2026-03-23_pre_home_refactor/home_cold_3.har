class=\"ra-label\">Cell information to subset</label>\n                          <div class=\"form-group shiny-input-container\">\n                            <label class=\"control-label shiny-label-null\" for=\"sc3d1sub1\" id=\"sc3d1sub1-label\"></label>\n                            <div>\n                              <select id=\"sc3d1sub1\" class=\"shiny-input-select\"><option value=\"Seurat Clusters\" selected>Seurat Clusters</option>\n<option value=\"Stages\">Stages</option>\n<option value=\"Major Cell Classes\">Major Cell Classes</option>\n<option value=\"Cell Types\">Cell Types</option></select>\n                              <script type=\"application/json\" data-for=\"sc3d1sub1\" data-nonempty=\"\">{\"plugins\":[\"selectize-plugin-a11y\"]}</script>\n                            </div>\n                          </div>\n                        </div>\n                        <div id=\"sc3d1sub1.ui\" class=\"shiny-html-output\"></div>\n                        <div class=\"ra-button-row\">\n                          <button class=\"btn btn-default action-button btn btn-primary btn-sm\" id=\"sc3d1sub1all\" type=\"button\">\n                            <span class=\"action-label\">Select all groups</span>\n                          </button>\n                          <button class=\"btn btn-default action-button btn btn-outline-secondary btn-sm\" id=\"sc3d1sub1non\" type=\"button\">\n                            <span class=\"action-label\">Deselect all groups</span>\n                          </button>\n                        </div>\n                      </div>\n                      <div class=\"ra-rowgroup\">\n                        <div class=\"ra-rowtitle\">Display options</div>\n                        <div class=\"ra-field\">\n                          <label class=\"ra-label\">Colour scheme</label>\n                          <div id=\"sc3d1cols\" class=\"form-group shiny-input-radiogroup shiny-input-container\" role=\"radiogroup\" aria-labelledby=\"sc3d1cols-label\">\n                            <label class=\"control-label shiny-label-null\" for=\"sc3d1cols\" id=\"sc3d1cols-label\"></label>\n                            <div class=\"shiny-options-group\">\n                              <div class=\"radio\">\n                                <label>\n                                  <input type=\"radio\" name=\"sc3d1cols\" value=\"White-Red\"/>\n                                  <span>White-Red</span>\n                                </label>\n                              </div>\n                              <div class=\"radio\">\n                                <label>\n                                  <input type=\"radio\" name=\"sc3d1cols\" value=\"Blue-Yellow-Red\" checked=\"checked\"/>\n                                  <span>Blue-Yellow-Red</span>\n                                </label>\n                              </div>\n                              <div class=\"radio\">\n                                <label>\n                                  <input type=\"radio\" name=\"sc3d1cols\" value=\"Yellow-Green-Purple\"/>\n                                  <span>Yellow-Green-Purple</span>\n                                </label>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                        <div class=\"ra-field\">\n                          <label class=\"ra-label\">Plot size</label>\n                          <div id=\"sc3d1psz\" class=\"form-group shiny-input-radiogroup shiny-input-container shiny-input-container-inline\" role=\"radiogroup\" aria-labelledby=\"sc3d1psz-label\">\n                            <label class=\"control-label shiny-label-null\" for=\"sc3d1psz\" id=\"sc3d1psz-label\"></label>\n                            <div class=\"shiny-options-group\">\n                              <label class=\"radio-inline\">\n                                <input type=\"radio\" name=\"sc3d1psz\" value=\"Small\"/>\n                                <span>Small</span>\n                              </label>\n                              <label class=\"radio-inline\">\n                                <input type=\"radio\" name=\"sc3d1psz\" value=\"Medium\"/>\n                                <span>Medium</span>\n                              </label>\n                              <label class=\"radio-inline\">\n                                <input type=\"radio\" name=\"sc3d1psz\" value=\"Large\" checked=\"checked\"/>\n                                <span>Large</span>\n                              </label>\n                            </div>\n                          </div>\n                        </div>\n                        <div class=\"ra-field\">\n                          <label class=\"ra-label\">Font size</label>\n                          <div id=\"sc3d1fsz\" class=\"form-group shiny-input-radiogroup shiny-input-container shiny-input-container-inline\" role=\"radiogroup\" aria-labelledby=\"sc3d1fsz-label\">\n                            <label class=\"control-label shiny-label-null\" for=\"sc3d1fsz\" id=\"sc3d1fsz-label\"></label>\n                            <div class=\"shiny-options-group\">\n                              <label class=\"radio-inline\">\n                                <input type=\"radio\" name=\"sc3d1fsz\" value=\"Small\"/>\n                                <span>Small</span>\n                              </label>\n                              <label class=\"radio-inline\">\n                                <input type=\"radio\" name=\"sc3d1fsz\" value=\"Medium\" checked=\"checked\"/>\n                                <span>Medium</span>\n                              </label>\n                              <label class=\"radio-inline\">\n                                <input type=\"radio\" name=\"sc3d1fsz\" value=\"Large\"/>\n                                <span>Large</span>\n                              </label>\n         