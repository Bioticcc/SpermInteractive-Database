                  <span>Blue-Yellow-Red</span>\n                                </label>\n                              </div>\n                              <div class=\"radio\">\n                                <label>\n                                  <input type=\"radio\" name=\"sc6a3col1\" value=\"Yellow-Green-Purple\"/>\n                                  <span>Yellow-Green-Purple</span>\n                                </label>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                        <div class=\"ra-field\">\n                          <label class=\"ra-label\">Plot order</label>\n                          <div id=\"sc6a3ord1\" class=\"form-group shiny-input-radiogroup shiny-input-container shiny-input-container-inline\" role=\"radiogroup\" aria-labelledby=\"sc6a3ord1-label\">\n                            <label class=\"control-label shiny-label-null\" for=\"sc6a3ord1\" id=\"sc6a3ord1-label\"></label>\n                            <div class=\"shiny-options-group\">\n                              <label class=\"radio-inline\">\n                                <input type=\"radio\" name=\"sc6a3ord1\" value=\"Max-1st\" checked=\"checked\"/>\n                                <span>Max-1st</span>\n                              </label>\n                              <label class=\"radio-inline\">\n                                <input type=\"radio\" name=\"sc6a3ord1\" value=\"Min-1st\"/>\n                                <span>Min-1st</span>\n                              </label>\n                              <label class=\"radio-inline\">\n                                <input type=\"radio\" name=\"sc6a3ord1\" value=\"Original\"/>\n                                <span>Original</span>\n                              </label>\n                              <label class=\"radio-inline\">\n                                <input type=\"radio\" name=\"sc6a3ord1\