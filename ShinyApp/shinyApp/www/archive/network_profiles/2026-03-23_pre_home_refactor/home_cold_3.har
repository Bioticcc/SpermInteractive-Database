          "content": {
            "mimeType": "text/css",
            "size": 11290,
            "text": "/* Unified home card look */\n.home-card {\n  padding: 16px;\n  border-radius: 12px;\n  background: #ffffff;          /* single consistent background */\n  border: 1px solid #e9ecef;    /* single consistent border */\n  margin-bottom: 16px;\n  transition: box-shadow 0.2s ease, transform 0.2s ease;\n}\n\n.home-top-row{\n  display: flex;\n  flex-wrap: wrap;\n  align-items: stretch;\n}\n\n.home-top-row > [class*='col-']{\n  display: flex;\n  flex-direction: column;\n}\n\n.home-top-row .home-card{\n  flex: 1 1 auto;\n  width: 100%;\n}\n\n.home-card-preview {\n  width: 100%;\n  height: 140px;\n  border-radius: 8px;\n  object-fit: contain;\n  object-position: center;\n  background: #ffffff;\n  margin-bottom: 12px;\n  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12);\n}\n\n\n.home-card-link {\n  display: block;\n  text-decoration: none;\n  color: inherit;\n}\n\n.home-card-link:hover .home-card,\n.home-card-link:focus .home-card {\n  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);\n  transform: translateY(-2px);\n  transition: box-shadow 0.2s ease, transform 0.2s ease;\n}\n\n.home-icon-grid{\n  display: flex;\n  flex-wrap: wrap;\n  align-items: stretch; /* equal-height columns */\n}\n\n.home-icon-grid > [class*='col-']{\n  display: flex;\n  flex-direction: column;\n}\n\n.home-icon-grid .home-card-link{\n  display: flex;\n  flex: 1 1 auto;\n  height: 100%;\n}\n\n.home-icon-grid .home-card-link .home-card{\n  display: flex;\n  flex-direction: column;\n  flex: 1 1 auto;\n  width: 100%;\n  margin-bottom: 0;\n}\n\n.home-icon-grid .home-card-preview{\n  height: 140px; /* keep preview heights consistent so text aligns */\n}\n\n.home-card-preview.fit-contain{\n  object-fit: contain;\n  background: #ffffff;\n}\n\n.home-icon-grid .home-card h4{\n  line-height: 1.2;\n  min-height: 2.4em; /* reserve space for up to ~2 lines so subtext starts aligned */\n  margin: 0 0 8px 0;\n}\n\n.home-card-link:focus-visible .home-card {\n  outline: 3px solid #4F46E5;\n  outline-offset: 4px;\n}\n\nhtml[data-theme='dark'] .home-card,\nhtml[data-theme='dark'] .theme-card{\n  background: rgba(15,16,26,0.9);\n  border-color: rgba(255,255,255,0.08);\n  box-shadow: 0 18px 36px rgba(0,0,0,0.55);\n  color: var(--color-text);\n}\n\nhtml[data-theme='dark'] .home-card-preview{\n  box-shadow: 0 8px 20px rgba(0,0,0,0.65);\n}\n\nhtml[data-theme='dark'] .home-card-link:focus-visible .home-card{\n  outline-color: rgba(20,184,166,0.7);\n}\n\n.theme-card{\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  background: rgba(255, 255, 255, 0.72);\n  border: 1px solid #e5e9f5;\n  border-radius: 16px;\n  padding: 24px 32px;\n  box-shadow: 0 18px 34px rgba(15, 23, 42, 0.08);\n  margin: 0;\n  width: 100%;\n  box-sizing: border-box;\n}\n\nhtml[data-theme='dark'] .theme-card{\n  background: rgba(15, 18, 30, 0.92);\n  border-color: rgba(99, 102, 241, 0.3);\n  box-shadow: 0 26px 52px rgba(2, 6, 23, 0.75);\n  color: var(--color-text);\n}\n\n.theme-card .control-label{\n  display: none;\n}\n\n.theme-picker{\n  width: 100%;\n}\n\n.theme-picker .shiny-options-group{\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n  width: 100%;\n  align-items: stretch;\n}\n\n.theme-picker .radio{\n  margin: 0;\n  display: flex;\n}\n\n.theme-picker .radio label{\n  display: flex;\n  flex-direction: column;\n  flex: 1 1 auto;\n  position: relative;\n  cursor: pointer;\n}\n\n.theme-picker .radio input[type=\"radio\"]{\n  position: absolute;\n  opacity: 0;\n  pointer-events: none;\n}\n\n.theme-option{\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  gap: 10px;\n  align-items: center;\n  padding: 18px 16px;\n  border-radius: 12px;\n  background: var(--color-white-translucent);\n  border: 1px solid var(--color-border);\n  width: 100%;\n  min-width: 0;\n  height: 100%;\n  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;\n  color: var(--color-text);\n  text-align: center;\n}\n\n.theme-picker .radio label:hover .theme-option{\n  transform: translateY(-2px);\n  box-shadow: 0 10px 24px var(--shadow-light);\n}\n\n.theme-picker input[type=\"radio\"]:checked + .theme-option{\n  border-color: var(--color-primary);\n  box-shadow: 0 14px 28px var(--shadow-medium);\n}\n\n.theme-picker input[type=\"radio\"]:focus-visible + .theme-option{\n  box-shadow: 0 0 0 3px var(--color-focus-shadow), 0 14px 28px var(--shadow-medium);\n}\n\n.theme-option-title{\n  font-weight: 600;\n  font-size: 1rem;\n}\n\n.theme-option-swatches{\n  display: flex;\n  gap: 6px;\n  justify-content: center;\n}\n\n.theme-option-swatch{\n  width: 28px;\n  height: 28px;\n  border-radius: 6px;\n  border: 1px solid rgba(15, 23, 42, 0.12);\n}\n\n:root[data-theme='dark'] .theme-option{\n  background: rgba(30, 41, 59, 0.92);\n  border-color: rgba(148, 163, 184, 0.24);\n}\n\n:root[data-theme='dark'] .theme-option-swatch{\n  border-color: rgba(226, 232, 240, 0.2);\n}\n\n@media (max-width: 900px){\n  .theme-picker .shiny-options-group{\n    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));\n  }\n}\n\n/* Welcome block adjustments */\n.home-card.home-hero h2 {\n  font-size: 2rem;   /* adjust as needed (2.2–3.0rem) */\n  margin: 4px 0 12px 0;\n  line-height: 1.2;\n}\n\n.home-card.home-hero p {\n  font-size: 1rem;  /* adjust as needed */\n  line-height: 1.7;\n}\n\n/* Optional: tighter list spacing */\n.home-card ul { margin-bottom: 0.5rem; }\n/* #7c3aed, #06b6d4);*/\n\n/* Make the SVG fill its container */\n#spermatogonia_svg { width: 100%; }\n#spermatogonia_svg svg {\n  display: block;         /* remove inline gap */\n  width: 100% !important; /* scale to column width */\n  height: auto !important;\n  max-width: 1200px;      /* optional: cap if you like */\n  margin: 0 auto;         /* keep it centered */\n}\n\n/* Optional: give the area some vertical space while loading */\n.svg-stage { \n  width: 100%;\n  max-width: 1200px;      /* match the cap above */\n  margin: 0 auto;\n}\n\n\n\n/* The plot card already has position:relative via glass-card; ensure it if not */\n.ra-card.ra-plot { position: relative; }\n\n/* Busy overlay (dim + text) */\n.ra-card.ra-plot.is-busy::after {\n  content: \"\";\n  position: absolute; inset: 0;\n  background: rgba(255,255,255,0.55);\n  backdrop-filter: blur(2px);\n  z-index: 20;\n}\n\nhtml[data-theme='dark'] .ra-card.ra-plot.is-busy::after{\n  background: rgba(5, 8, 20, 0.72);\n}\n\n.ra-card.ra-plot.is-busy::before {\n  content: \"Figures are loading, please wait\";\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  padding: 10px 14px;\n  border-radius: 999px;\n  font-weight: 600;\n  font-size: 16px;\n  line-height: 1.2;\n  color: #1f2937;\n  background: rgba(255,255,255,0.9);\n  border: 1px solid rgba(15,23,42,0.12);\n  box-shadow: 0 14px 30px rgba(15,23,42,0.12);\n  z-index: 21;\n  text-align: center;\n}\n\nhtml[data-theme='dark'] .ra-card.ra-plot.is-busy::before{\n  color: #e2e8f0;\n  background: rgba(9, 15, 32, 0.92);\n  border-color: rgba(148, 163, 184, 0.28);\n  box-shadow: 0 18px 40px rgba(2, 6, 23, 0.85);\n}\n\n@keyframes spgspin { to { transform: rotate(360deg); } }\n\n\n/* If both classes are present, show the active (blue) color */\n.cell-btn.btn-gmatch.btn-highlight {\n  outline-color: #4F46E5 !important;\n}\n\n/* Prevent native focus ring from stacking with our custom outlines */\n.cell-btn:focus { outline: none !important; }\n\n/* Remove the browser's default thick blue focus ring */\nbutton:focus {\n  outline: none !important;\n  box-shadow: none !important;\n}\n\n/* Keep your custom smaller square light blue border */\nbutton.custom-btn:focus-visible {\n  outline: 2px solid #4da6ff; /* or whatever your current square highlight color is */\n  border-radius: 4px;         /* keep it sharp */\n}\n\n\n\n/* Scope to the table so other buttons keep normal focus styles */\n.interactive-table .table-btn:focus,\n.interactive-table .table-btn:focus-visible,\n.interactive-table .table-btn:active:focus {\n  box-shadow: none !important;   /* removes Bootstrap’s big rounded ring */\n  outline: none;                 /* don’t double up */\n}\n\n/* Keep the crisp, smaller square highlight */\n.interactive-table .table-btn:focus-visible {\n  outline: 2px solid #7ec4ff;    /* your light-blue square */\n  outline-offset: 0;\n  border-radius: 6px;            /* make it squarer if needed */\n}\n\n/* --- SVG cell highlight rules --- */\n.cell-btn {\n  stroke: none;\n  fill: transparent;\n  rx: 2;\n  ry: 2;\n  transition: stroke 120ms ease, fill 120ms ease, fill-opacity 120ms ease;\n}\n\n/* Fallback styles so matches are visible while colors load */\n.cell-btn.btn-gmatch {\n  stroke: #22D3EE;\n  stroke-width: 2px;\n  fill: rgba(34, 211, 238, 0.18);\n}\n\n/* Modal selection override */\n.cell-btn.btn-highlight {\n  stroke: #4F46E5 !important;\n  stroke-width: 3px;\n  fill: rgba(79, 70, 229, 0.12) !important;\n  fill-opacity: 1 !important;\n}\n\n.cell-btn.btn-gmatch.btn-highlight {\n  stroke: #4F46E5 !important;\n}\n\n.cell-btn,\n.cell-btn.btn-gmatch,\n.cell-btn.btn-highlight {\n  outline: none !important;\n}\n\n.cell-btn.heat-on {\n  cursor: pointer;\n}\n\n/* Optional: a tiny legend chip */\n.heat-legend {\n  display: inline-flex; align-items: center; gap: 8px; font-size: 12px;\n}\n\n.heat-gradient {\n  width: 120px; height: 10px; border-radius: 999px;\n  background: linear-gradient(to right, #f7fbff, #c6dbef, #6baed6, #2171b5, #084594);\n  border: 1px solid #a5b7c6;\n}\n\n.heat-legend-note {\n  margin: 6px 0 0;\n  font-size: 18px;\n  color: #000000;\n  line-height: 1.4;\n}\n\nhtml[data-theme='dark'] .heat-legend-note {\n  color: #ffffff;\n}\n\n\n.heat-label {\n  font: 25px/1 monospace;\n  fill: #111;\n  text-anchor: middle;\n  dominant-baseline: central;\n  pointer-events: none;\n  paint-order: stroke;\n  stroke: #fff;         /* white halo for contrast */\n  stroke-width: 2px;\n  opacity: 0.9;\n}\n\n\n/* Consistent sidebar width across panes */\n.ra-pane .ra-controls {\n  flex: 0 0 320px;   /* fixed column width */\n  max-width: 340px;\n}\n.ra-pane .ra-plot {\n  flex: 1 1 0%;\n  min-width: 0;      /* prevents overflow */\n}\n\n/* Print-only layout reset for clean Save as PDF output */\n@media print {\n  @page {\n    margin: 0.5in;\n  }\n\n  html,\n  body {\n    background: #ffffff !important;\n    background-attachment: scroll !important;\n    height: auto !important;\n    min-height: 0 !important;\n    overflow: visible !important;\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n\n  * {\n    animation: none !important;\n    transition: none !important;\n  }\n\n  .container,\n  .container-fluid,\n  .tab-content,\n  .row,\n  [class*='col-'] {\n    overflow: visible !important;\n    height: auto !important;\n    min-height: 0 !important;\n    max-height: none !important;\n  }\n\n  .container .tab-content,\n  .container-fluid .tab-content {\n    position: static !important;\n    left: auto !important;\n    right: auto !important;\n    margin: 0 !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    min-height: 0 !important;\n    padding: 0 !important;\n    border: 0 !important;\n    box-shadow: none !important;\n    background: transparent !important;\n  }\n\n  .container .tab-content::before,\n  .container-fluid .tab-content::before {\n    content: none !important;\n    display: none !important;\n  }\n\n  .ra-controls {\n    position: static !important;\n    top: auto !important;\n  }\n\n  .ra-card,\n  .home-card,\n  .glass-card,\n  .theme-card,\n  .ra-pane,\n  .legacy-pane,\n  .ra-plot-holder {\n    overflow: visible !important;\n    page-break-inside: avoid;\n    break-inside: avoid;\n  }\n\n  .shiny-spinner-overlay {\n    display: none !important;\n  }\n}\n"
