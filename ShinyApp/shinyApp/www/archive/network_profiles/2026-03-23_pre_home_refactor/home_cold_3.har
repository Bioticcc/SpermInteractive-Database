            "text": "\n:root {\n  --app-font: \"Quicksand\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  --plot-holder-bg: #ffffff;\n  --plot-holder-border: rgba(15,23,42,0.05);\n  --aurora-a: rgba(124, 58, 237, 0.22);\n  --aurora-b: rgba(14, 165, 233, 0.18);\n  --aurora-c: rgba(16, 185, 129, 0.16);\n  --spinner-color: #4A90E2;\n  --spinner-bg: rgba(255,255,255,0.55);\n  --plot-min-height: 520px;\n}\n\nbody, \nhtml, \n.shiny-app, \n.container-fluid, \n.navbar, \n.tab-content {\n  font-family: var(--app-font);\n}\n\n\n\n\n\n/* === Light Blue Theme (Default) === */\n:root[data-theme='lightblue'] {\n  --color-bg-gradient-1: #e0f7fa;\n  --color-bg-gradient-2: #b2ebf2;\n  --color-bg-gradient-3: #81d4fa;\n\n  --color-html-bg-1: #d0eafc;\n  --color-html-bg-2: #c0e4f4;\n  --color-html-bg-3: #a0d0f0;\n\n  --color-header-start: #4A90E2;\n  --color-header-end: #7ED6DF;\n\n  --color-primary: #4A90E2;\n  --color-primary-hover: #357ABD;\n\n  --color-text: #2C3E50;\n  --color-white-translucent: rgba(255,255,255,0.8);\n  --color-input-bg: #f0f0f0;\n  --color-border: #ccc;\n\n  --color-link-bg: rgba(74, 144, 226, 0.2);\n--color-link-hover-bg: rgba(74, 144, 226, 0.3);\n--color-link-hover-text: #357ABD;\n\n\n  --color-focus-shadow: rgba(74, 144, 226, 0.3);\n  --color-focus-shadow-soft: rgba(74, 144, 226, 0.2);\n\n  --shadow-light: rgba(0,0,0,0.08);\n  --shadow-medium: rgba(0,0,0,0.1);\n  --shadow-strong: rgba(0,0,0,0.2);\n\n  --aurora-a: rgba(74, 144, 226, 0.25);\n  --aurora-b: rgba(45, 197, 253, 0.18);\n  --aurora-c: rgba(129, 199, 132, 0.16);\n  --spinner-color: #3b82f6;\n  --spinner-bg: rgba(222, 241, 255, 0.7);\n}\n\n\n\n:root[data-theme='dark'] {\n  --color-bg-gradient-1: #1e1e1e;\n  --color-bg-gradient-2: #2a2a2a;\n  --color-bg-gradient-3: #3a3a3a;\n\n  --color-html-bg-1: #1e1e1e;\n  --color-html-bg-2: #252525;\n  --color-html-bg-3: #2d2d2d;\n\n  --color-header-start: #0f172a;\n  --color-header-end: #1e293b;\n\n  --color-primary: #4F46E5;\n  --color-primary-hover: #3B82F6;\n\n  --color-text: #eeeeee;\n  --color-white-translucent: rgba(7, 11, 24, 0.92);\n  --color-input-bg: rgba(8, 13, 32, 0.95);\n  --color-border: rgba(148, 163, 184, 0.35);\n\n  --color-link-bg: rgba(255, 255, 255, 0.08);\n  --color-link-hover-bg: rgba(255, 255, 255, 0.15);\n  --color-link-hover-text: #ffffff;\n\n\n  --color-focus-shadow: rgba(255, 255, 255, 0.1);\n  --color-focus-shadow-soft: rgba(255, 255, 255, 0.05);\n\n  --shadow-light: rgba(0, 0, 0, 0.3);\n  --shadow-medium: rgba(0, 0, 0, 0.4);\n  --shadow-strong: rgba(0, 0, 0, 0.6);\n\n  --hdr-fg: #f5f7ff;\n  --hdr-fg-sub: #cbd5f5;\n  --hdr-grad-a: #6366f1;\n  --hdr-grad-b: #14b8a6;\n  --hdr-glass: 18px;\n  --glass-top: rgba(30, 32, 45, 0.92);\n  --glass-bot: rgba(16, 18, 27, 0.94);\n  --color-surface-card: #0f172a;\n  --color-surface-card-raised: #141f3f;\n  --color-control-bg: #142347;\n  --color-control-bg-hover: #1c2f63;\n  --color-control-border: rgba(59, 130, 246, 0.35);\n  --color-control-border-strong: rgba(99, 102, 241, 0.6);\n  --plot-holder-bg: #050815;\n  --plot-holder-border: rgba(99, 102, 241, 0.4);\n\n  --aurora-a: rgba(99, 102, 241, 0.35);\n  --aurora-b: rgba(14, 165, 233, 0.28);\n  --aurora-c: rgba(20, 184, 166, 0.24);\n  --spinner-color: #93c5fd;\n  --spinner-bg: rgba(5, 8, 20, 0.72);\n  --plot-min-height: 520px;\n}\n\n\n:root[data-theme='default'] {\n  --color-bg-gradient-1: #ffffff;\n  --color-bg-gradient-2: #ffffff;\n  --color-bg-gradient-3: #ffffff;\n  --color-html-bg-1: #ffffff;\n  --color-html-bg-2: #ffffff;\n  --color-html-bg-3: #ffffff;\n  --color-header-start: #333333;\n  --color-header-end: #333333;\n  --color-primary: #000000;\n  --color-primary-hover: #333333;\n  --color-text: #000000;\n  --color-white-translucent: rgba(255,255,255,0.9);\n  --color-input-bg: #f9f9f9;\n  --color-border: #ccc;\n  --color-link-bg: rgba(0,0,0,0.05);\n  --color-link-hover-bg: rgba(0,0,0,0.1);\n  --color-link-hover-text: #000000;\n  --color-link-border: rgba(0, 0, 0, 0.4);\n  --color-link-hover-border: rgba(0, 0, 0, 0.6);\n  --color-focus-shadow: rgba(0, 0, 0, 0.15);\n  --color-focus-shadow-soft: rgba(0, 0, 0, 0.1);\n  --shadow-light: rgba(0, 0, 0, 0.05);\n  --shadow-medium: rgba(0, 0, 0, 0.1);\n  --shadow-strong: rgba(0, 0, 0, 0.2);\n}\n\n\n:root[data-theme='forest'] {\n  --color-bg-gradient-1: #a8e6cf;\n  --color-bg-gradient-2: #dcedc1;\n  --color-bg-gradient-3: #ffd3b6;\n  --color-html-bg-1: #a8e6cf;\n  --color-html-bg-2: #dcedc1;\n  --color-html-bg-3: #ffd3b6;\n  --color-header-start: #1B5E20;\n  --color-header-end: #388E3C;\n  --color-primary: #1B5E20;\n  --color-primary-hover: #388E3C;\n  --color-text: #1a1a1a;\n  --color-white-translucent: rgba(255,255,255,0.85);\n  --color-input-bg: #f9f9f9;\n  --color-border: #ccc;\n  --color-link-bg: rgba(0,0,0,0.05);\n  --color-link-hover-bg: rgba(0,0,0,0.1);\n  --color-link-hover-text: #000000;\n  --color-link-border: rgba(0, 0, 0, 0.4);\n  --color-link-hover-border: rgba(0, 0, 0, 0.6);\n  --color-focus-shadow: rgba(0, 0, 0, 0.15);\n  --color-focus-shadow-soft: rgba(0, 0, 0, 0.1);\n  --shadow-light: rgba(0, 0, 0, 0.05);\n  --shadow-medium: rgba(0, 0, 0, 0.1);\n  --shadow-strong: rgba(0, 0, 0, 0.2);\n}\n\n\n:root[data-theme='sunset'] {\n  --color-bg-gradient-1: #ff9a9e;\n  --color-bg-gradient-2: #fad0c4;\n  --color-bg-gradient-3: #ffdde1;\n  --color-html-bg-1: #ff9a9e;\n  --color-html-bg-2: #fad0c4;\n  --color-html-bg-3: #ffdde1;\n  --color-header-start: #ff6f61;\n  --color-header-end: #c62828;\n  --color-primary: #ff6f61;\n  --color-primary-hover: #c62828;\n  --color-text: #1a1a1a;\n  --color-white-translucent: rgba(255,255,255,0.85);\n  --color-input-bg: #f9f9f9;\n  --color-border: #ccc;\n  --color-link-bg: rgba(0,0,0,0.05);\n  --color-link-hover-bg: rgba(0,0,0,0.1);\n  --color-link-hover-text: #000000;\n  --color-link-border: rgba(0, 0, 0, 0.4);\n  --color-link-hover-border: rgba(0, 0, 0, 0.6);\n  --color-focus-shadow: rgba(0, 0, 0, 0.15);\n  --color-focus-shadow-soft: rgba(0, 0, 0, 0.1);\n  --shadow-light: rgba(0, 0, 0, 0.05);\n  --shadow-medium: rgba(0, 0, 0, 0.1);\n  --shadow-strong: rgba(0, 0, 0, 0.2);\n}\n\n\n:root[data-theme='ocean'] {\n  --color-bg-gradient-1: #a1c4fd;\n  --color-bg-gradient-2: #c2e9fb;\n  --color-bg-gradient-3: #81d4fa;\n  --color-html-bg-1: #a1c4fd;\n  --color-html-bg-2: #c2e9fb;\n  --color-html-bg-3: #81d4fa;\n  --color-header-start: #039be5;\n  --color-header-end: #01579b;\n  --color-primary: #039be5;\n  --color-primary-hover: #01579b;\n  --color-text: #1a1a1a;\n  --color-white-translucent: rgba(255,255,255,0.85);\n  --color-input-bg: #f9f9f9;\n  --color-border: #ccc;\n  --color-link-bg: rgba(0,0,0,0.05);\n  --color-link-hover-bg: rgba(0,0,0,0.1);\n  --color-link-hover-text: #000000;\n  --color-link-border: rgba(0, 0, 0, 0.4);\n  --color-link-hover-border: rgba(0, 0, 0, 0.6);\n  --color-focus-shadow: rgba(0, 0, 0, 0.15);\n  --color-focus-shadow-soft: rgba(0, 0, 0, 0.1);\n  --shadow-light: rgba(0, 0, 0, 0.05);\n  --shadow-medium: rgba(0, 0, 0, 0.1);\n  --shadow-strong: rgba(0, 0, 0, 0.2);\n}\n\n\n:root[data-theme='lavender'] {\n  --color-bg-gradient-1: #e1bee7;\n  --color-bg-gradient-2: #f3e5f5;\n  --color-bg-gradient-3: #ce93d8;\n  --color-html-bg-1: #e1bee7;\n  --color-html-bg-2: #f3e5f5;\n  --color-html-bg-3: #ce93d8;\n  --color-header-start: #8e24aa;\n  --color-header-end: #6a1b9a;\n  --color-primary: #8e24aa;\n  --color-primary-hover: #6a1b9a;\n  --color-text: #1a1a1a;\n  --color-white-translucent: rgba(255,255,255,0.85);\n  --color-input-bg: #f9f9f9;\n  --color-border: #ccc;\n  --color-link-bg: rgba(0,0,0,0.05);\n  --color-link-hover-bg: rgba(0,0,0,0.1);\n  --color-link-hover-text: #000000;\n  --color-link-border: rgba(0, 0, 0, 0.4);\n  --color-link-hover-border: rgba(0, 0, 0, 0.6);\n  --color-focus-shadow: rgba(0, 0, 0, 0.15);\n  --color-focus-shadow-soft: rgba(0, 0, 0, 0.1);\n  --shadow-light: rgba(0, 0, 0, 0.05);\n  --shadow-medium: rgba(0, 0, 0, 0.1);\n  --shadow-strong: rgba(0, 0, 0, 0.2);\n}\n\n\n:root[data-theme='sand'] {\n  --color-bg-gradient-1: #fff8e1;\n  --color-bg-gradient-2: #ffecb3;\n  --color-bg-gradient-3: #ffe082;\n  --color-html-bg-1: #fff8e1;\n  --color-html-bg-2: #ffecb3;\n  --color-html-bg-3: #ffe082;\n  --color-header-start: #f57c00;\n  --color-header-end: #e65100;\n  --color-primary: #f57c00;\n  --color-primary-hover: #e65100;\n  --color-text: #1a1a1a;\n  --color-white-translucent: rgba(255,255,255,0.85);\n  --color-input-bg: #f9f9f9;\n  --color-border: #ccc;\n  --color-link-bg: rgba(0,0,0,0.05);\n  --color-link-hover-bg: rgba(0,0,0,0.1);\n  --color-link-hover-text: #000000;\n  --color-link-border: rgba(0, 0, 0, 0.4);\n  --color-link-hover-border: rgba(0, 0, 0, 0.6);\n  --color-focus-shadow: rgba(0, 0, 0, 0.15);\n  --color-focus-shadow-soft: rgba(0, 0, 0, 0.1);\n  --shadow-light: rgba(0, 0, 0, 0.05);\n  --shadow-medium: rgba(0, 0, 0, 0.1);\n  --shadow-strong: rgba(0, 0, 0, 0.2);\n}\n\n\n:root[data-theme='berry'] {\n  --color-bg-gradient-1: #f48fb1;\n  --color-bg-gradient-2: #f06292;\n  --color-bg-gradient-3: #ec407a;\n  --color-html-bg-1: #f48fb1;\n  --color-html-bg-2: #f06292;\n  --color-html-bg-3: #ec407a;\n  --color-header-start: #c2185b;\n  --color-header-end: #880e4f;\n  --color-primary: #c2185b;\n  --color-primary-hover: #880e4f;\n  --color-text: #1a1a1a;\n  --color-white-translucent: rgba(255,255,255,0.85);\n  --color-input-bg: #f9f9f9;\n  --color-border: #ccc;\n  --color-link-bg: rgba(0,0,0,0.05);\n  --color-link-hover-bg: rgba(0,0,0,0.1);\n  --color-link-hover-text: #000000;\n  --color-link-border: rgba(0, 0, 0, 0.4);\n  --color-link-hover-border: rgba(0, 0, 0, 0.6);\n  --color-focus-shadow: rgba(0, 0, 0, 0.15);\n  --color-focus-shadow-soft: rgba(0, 0, 0, 0.1);\n  --shadow-light: rgba(0, 0, 0, 0.05);\n  --shadow-medium: rgba(0, 0, 0, 0.1);\n  --shadow-strong: rgba(0, 0, 0, 0.2);\n}\n\n\n:root[data-theme='night'] {\n  --color-bg-gradient-1: #212121;\n  --color-bg-gradient-2: #424242;\n  --color-bg-gradient-3: #616161;\n  --color-html-bg-1: #212121;\n  --color-html-bg-2: #424242;\n  --color-html-bg-3: #616161;\n  --color-header-start: #e0e0e0;\n  --color-header-end: #ffffff;\n  --color-primary: #e0e0e0;\n  --color-primary-hover: #ffffff;\n  --color-text: #ffffff;\n  --color-white-translucent: rgba(255,255,255,0.1);\n  --color-input-bg: #2c2c2c;\n  --color-border: #555;\n  --color-link-bg: rgba(255,255,255,0.08);\n  --color-link-hover-bg: rgba(255,255,255,0.15);\n  --color-link-hover-text: #ffffff;\n  --color-link-border: rgba(255, 255, 255, 0.5);\n  --color-link-hover-border: rgba(255, 255, 255, 0.9);\n  --color-focus-shadow: rgba(255, 255, 255, 0.1);\n  --color-focus-shadow-soft: rgba(255, 255, 255, 0.05);\n  --shadow-light: rgba(0, 0, 0, 0.3);\n  --shadow-medium: rgba(0, 0, 0, 0.4);\n  --shadow-strong: rgba(0, 0, 0, 0.6);\n}\n\n\n:root[data-theme='mint'] {\n  --color-bg-gradient-1: #b2dfdb;\n  --color-bg-gradient-2: #80cbc4;\n  --color-bg-gradient-3: #4db6ac;\n  --color-html-bg-1: #b2dfdb;\n  --color-html-bg-2: #80cbc4;\n  --color-html-bg-3: #4db6ac;\n  --color-header-start: #009688;\n  --color-header-end: #004d40;\n  --color-primary: #009688;\n  --color-primary-hover: #004d40;\n  --color-text: #1a1a1a;\n  --color-white-translucent: rgba(255,255,255,0.85);\n  --color-input-bg: #f9f9f9;\n  --color-border: #ccc;\n  --color-link-bg: rgba(0,0,0,0.05);\n  --color-link-hover-bg: rgba(0,0,0,0.1);\n  --color-link-hover-text: #000000;\n  --color-link-border: rgba(0, 0, 0, 0.4);\n  --color-link-hover-border: rgba(0, 0, 0, 0.6);\n  --color-focus-shadow: rgba(0, 0, 0, 0.15);\n  --color-focus-shadow-soft: rgba(0, 0, 0, 0.1);\n  --shadow-light: rgba(0, 0, 0, 0.05);\n  --shadow-medium: rgba(0, 0, 0, 0.1);\n  --shadow-strong: rgba(0, 0, 0, 0.2);\n}\n\n/* New styles for SVG cells */\n#sperma-wrapper {\n  position: relative;\n  display: inline-block;\n  width: 100%;\n  max-width: 900px; /* controls max size, change if you want bigger */\n}\n\n#sperma-svg {\n  width: 100%;\n  height: auto;\n  display: block;\n}\n\n.cell-btn {\n  fill: transparent;\n  stroke: none;\n  cursor: pointer;\n  rx: 6; /* rounded corners similar to your buttons */\n  ry: 6;\n}\n\n/* Highlight from server message */\n.btn-highlight {\n  stroke: #007bff !important;\n  stroke-width: 2px !important;\n  fill: rgba(0, 123, 255, 0.15) !important;\n}\n\n/* add to style.css */\n.cell-btn:hover { stroke: #06b6d4; stroke-width: 1px; }\n\n\n/* === Custom App Styling === */\n\n/* Rounded and modern buttons */\n.btn,\n.action-button,\n.btn-default,\nbutton.dt-button,\ndiv.dt-buttons button.dt-button {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.35rem;\n  border-radius: 999px !important;\n  border: 1px solid rgba(255, 255, 255, 0.45);\n  padding: 0.55rem 1.35rem;\n  font-weight: 600;\n  font-size: 0.95rem;\n  letter-spacing: 0.01em;\n  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-hover));\n  color: #ffffff;\n  box-shadow: 0 10px 22px var(--shadow-light);\n  transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, filter 0.18s ease;\n}\n\n.btn.btn-sm,\nbutton.dt-button.btn-sm {\n  padding: 0.4rem 1.05rem;\n  font-size: 0.88rem;\n}\n\n.btn:hover,\n.btn:focus,\n.action-button:hover,\n.action-button:focus,\n.btn-default:hover,\n.btn-default:focus,\nbutton.dt-button:hover,\nbutton.dt-button:focus {\n  transform: translateY(-1px);\n  filter: brightness(1.05);\n  box-shadow: 0 14px 28px var(--shadow-medium);\n  color: #ffffff;\n  text-decoration: none;\n}\n\n.btn:active,\n.action-button:active,\n.btn-default:active,\nbutton.dt-button:active {\n  transform: translateY(0);\n  filter: brightness(0.95);\n  box-shadow: 0 6px 16px var(--shadow-light);\n}\n\n.btn:focus-visible,\n.action-button:focus-visible,\n.btn-default:focus-visible,\nbutton.dt-button:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 3px var(--color-focus-shadow), 0 10px 22px var(--shadow-light);\n}\n\n.btn.btn-outline,\n.btn.btn-secondary,\nbutton.dt-button.btn-outline {\n  background: rgba(255, 255, 255, 0.15);\n  color: var(--color-text);\n  border-color: rgba(255, 255, 255, 0.55);\n}\n\n.btn.btn-outline:hover,\n.btn.btn-secondary:hover,\nbutton.dt-button.btn-outline:hover {\n  background: rgba(255, 255, 255, 0.25);\n  color: var(--color-text);\n}\n\n.btn[disabled],\n.btn.disabled,\n.action-button[disabled],\n.btn-default[disabled],\nbutton.dt-button.disabled {\n  opacity: 0.55;\n  box-shadow: none;\n  cursor: not-allowed;\n}\n\nhtml[data-theme='dark'] .btn,\nhtml[data-theme='dark'] .action-button,\nhtml[data-theme='dark'] .btn-default,\nhtml[data-theme='dark'] button.dt-button,\nhtml[data-theme='dark'] div.dt-buttons button.dt-button {\n  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-hover));\n  border: 1px solid var(--color-control-border);\n  color: #e2e8f0;\n  box-shadow: 0 20px 42px rgba(2, 6, 23, 0.75);\n}\n\nhtml[data-theme='dark'] .btn:hover,\nhtml[data-theme='dark'] .btn:focus,\nhtml[data-theme='dark'] .action-button:hover,\nhtml[data-theme='dark'] .action-button:focus,\nhtml[data-theme='dark'] .btn-default:hover,\nhtml[data-theme='dark'] .btn-default:focus,\nhtml[data-theme='dark'] button.dt-button:hover,\nhtml[data-theme='dark'] button.dt-button:focus {\n  box-shadow: 0 26px 50px rgba(2, 6, 23, 0.85);\n  filter: brightness(1.02);\n}\n\nhtml[data-theme='dark'] .btn.btn-outline,\nhtml[data-theme='dark'] .btn.btn-secondary,\nhtml[data-theme='dark'] button.dt-button.btn-outline {\n  background: rgba(20, 35, 71, 0.85);\n  border-color: var(--color-control-border);\n  color: #f8fafc;\n}\n\nhtml[data-theme='dark'] .btn.btn-outline:hover,\nhtml[data-theme='dark'] .btn.btn-secondary:hover,\nhtml[data-theme='dark'] button.dt-button.btn-outline:hover {\n  background: rgba(30, 52, 104, 0.9);\n}\n\n/* Navbar customization */\n.navbar-default {\n  background: linear-gradient(to right, var(--color-header-start), var(--color-header-end));\n  border: none;\n  border-radius: 0;\n}\n\n.navbar-default .navbar-nav > li > a,\n.navbar-default .navbar-brand {\n  color: white !important;\n  font-weight: bold;\n}\n\nhtml[data-theme='dark'] .navbar-default .navbar-nav > li > a,\nhtml[data-theme='dark'] .navbar-default .navbar-brand {\n  color: var(--hdr-fg, #f8fafc) !important;\n}\n\nhtml[data-theme='dark'] .navbar-nav .dropdown-menu {\n  background-color: rgba(7, 11, 24, 0.95);\n  border: 1px solid var(--color-control-border);\n  box-shadow: 0 24px 48px rgba(2, 6, 23, 0.85);\n}\n\nhtml[data-theme='dark'] .navbar-nav .dropdown-menu > li > a {\n  color: var(--color-text);\n}\n\nhtml[data-theme='dark'] .navbar-nav .dropdown-menu > li > a:hover,\nhtml[data-theme='dark'] .navbar-nav .dropdown-menu > li > a:focus {\n  background-color: rgba(37, 56, 116, 0.55);\n  color: var(--color-text);\n}\n\n/* Modal Styling */\n.modal-content {\n  border-radius: 10px;\n  box-shadow: 0 4px 16px var(--shadow-strong);\n}\n\nhtml[data-theme='dark'] .modal-content {\n  background: rgba(12, 18, 32, 0.96);\n  color: var(--color-text);\n  border: 1px solid var(--color-control-border);\n  box-shadow: 0 24px 50px rgba(2, 6, 23, 0.85);\n}\n\nhtml[data-theme='dark'] .modal-header,\nhtml[data-theme='dark'] .modal-footer {\n  border-color: rgba(99, 102, 241, 0.25);\n}\n\nhtml[data-theme='dark'] .modal-title,\nhtml[data-theme='dark'] .modal-body,\nhtml[data-theme='dark'] .modal-content .close {\n  color: var(--color-text);\n}\n\nhtml[data-theme='dark'] .popover {\n  background: rgba(12, 18, 32, 0.96);\n  color: var(--color-text);\n  border: 1px solid var(--color-control-border);\n  box-shadow: 0 18px 40px rgba(2, 6, 23, 0.7);\n}\n\nhtml[data-theme='dark'] .popover-title,\nhtml[data-theme='dark'] .popover-header {\n  background: rgba(15, 23, 42, 0.98);\n  border-bottom: 1px solid rgba(99, 102, 241, 0.25);\n  color: var(--color-text);\n}\n\nhtml[data-theme='dark'] .popover-content,\nhtml[data-theme='dark'] .popover-body {\n  color: var(--color-text);\n}\n\nhtml[data-theme='dark'] .tooltip-inner {\n  background: rgba(15, 23, 42, 0.95);\n  color: var(--color-text);\n  box-shadow: 0 10px 24px rgba(2, 6, 23, 0.6);\n}\n\nhtml[data-theme='dark'] .tooltip.top .tooltip-arrow {\n  border-top-color: rgba(15, 23, 42, 0.95);\n}\n\nhtml[data-theme='dark'] .tooltip.bottom .tooltip-arrow {\n  border-bottom-color: rgba(15, 23, 42, 0.95);\n}\n\nhtml[data-theme='dark'] .tooltip.left .tooltip-arrow {\n  border-left-color: rgba(15, 23, 42, 0.95);\n}\n\nhtml[data-theme='dark'] .tooltip.right .tooltip-arrow {\n  border-right-color: rgba(15, 23, 42, 0.95);\n}\n\n.modal-dialog.spg-modal .modal-content {\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(224, 243, 255, 0.9));\n  background-size: 200% 200%;\n  animation: gradientFlow 32s ease-in-out infinite alternate;\n  border: 1px solid rgba(15, 23, 42, 0.08);\n  color: var(--color-text);\n  overflow: hidden;\n  position: relative;\n}\n\n.modal-dialog.spg-modal .modal-header,\n.modal-dialog.spg-modal .modal-footer {\n  background: transparent;\n  border-color: rgba(15, 23, 42, 0.08);\n}\n\n.modal-dialog.spg-modal .modal-title {\n  font-weight: 700;\n  letter-spacing: 0.3px;\n  color: inherit;\n}\n\n.modal-dialog.spg-modal .modal-body {\n  background: transparent;\n  color: inherit;\n  max-height: calc(100vh - 220px);\n  overflow-y: hidden;\n}\n\n.modal-dialog.spg-modal .btn.spg-modal-close {\n  border-radius: 10px;\n  font-weight: 600;\n  padding: 8px 18px;\n  background: linear-gradient(135deg, rgba(74, 144, 226, 0.95), rgba(124, 201, 255, 0.9));\n  border: 1px solid rgba(74, 144, 226, 0.35);\n  color: #0f172a;\n  box-shadow: 0 14px 28px rgba(74, 144, 226, 0.22);\n  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;\n}\n\n.modal-dialog.spg-modal .btn.spg-modal-close:hover,\n.modal-dialog.spg-modal .btn.spg-modal-close:focus-visible {\n  transform: translateY(-1px);\n  border-color: rgba(74, 144, 226, 0.6);\n  box-shadow: 0 18px 40px rgba(74, 144, 226, 0.28);\n}\n\n.spg-modal-summary {\n  margin-bottom: 16px;\n  padding: 12px 16px;\n  border-radius: 12px;\n  background: rgba(74, 144, 226, 0.08);\n  border: 1px solid rgba(74, 144, 226, 0.18);\n  font-size: 0.95rem;\n  line-height: 1.55;\n}\n\n.spg-modal-summary b {\n  font-weight: 700;\n  color: inherit;\n}\n\n.spg-modal-gene-table {\n  margin-bottom: 14px;\n  width: 100%;\n  max-height: 360px;\n  overflow-y: auto;\n  border-radius: 10px;\n}\n\n.spg-modal-gene-table table {\n  width: 100%;\n  table-layout: fixed;\n  border-collapse: collapse;\n  background: rgba(255, 255, 255, 0.9);\n  border: 1px solid rgba(15, 23, 42, 0.12);\n  border-radius: 10px;\n  overflow: hidden;\n}\n\n.spg-modal-gene-table th,\n.spg-modal-gene-table td {\n  padding: 8px 10px !important;\n  border-color: rgba(15, 23, 42, 0.08) !important;\n  word-break: break-word;\n}\n\n.spg-modal-gene-table th {\n  font-weight: 700;\n  background: rgba(74, 144, 226, 0.12);\n  position: sticky;\n  top: 0;\n  z-index: 2;\n}\n\n.spg-modal-gene-table::-webkit-scrollbar {\n  width: 8px;\n}\n\n.spg-modal-gene-table::-webkit-scrollbar-track {\n  background: rgba(148, 163, 184, 0.15);\n  border-radius: 999px;\n}\n\n.spg-modal-gene-table::-webkit-scrollbar-thumb {\n  background: rgba(74, 144, 226, 0.45);\n  border-radius: 999px;\n}\n\n.spg-modal-download-wrap {\n  display: flex;\n  justify-content: flex-end;\n}\n\n.modal-dialog.spg-modal .btn.spg-modal-download {\n  border-radius: 10px;\n  font-weight: 600;\n}\n\n.spg-modal-search-block {\n  margin-bottom: 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.spg-modal-search {\n  border-radius: 12px;\n  border: 1px solid rgba(15, 23, 42, 0.12);\n  padding: 10px 14px;\n  font-size: 0.95rem;\n  box-shadow: 0 1px 0 rgba(16, 24, 40, 0.04) inset;\n  background: rgba(255, 255, 255, 0.9);\n  color: var(--color-text);\n}\n\n.spg-modal-search:focus {\n  border-color: var(--color-primary);\n  box-shadow: 0 0 0 3px var(--color-focus-shadow-soft);\n  outline: none;\n}\n\n.spg-modal-search-result {\n  font-weight: 600;\n  color: var(--color-primary);\n  font-size: 0.92rem;\n}\n\nhtml[data-theme='dark'] .modal-dialog.spg-modal .modal-content {\n  background: linear-gradient(180deg, rgba(20, 24, 38, 0.95), rgba(10, 13, 24, 0.94));\n  background-size: 220% 220%;\n  animation: gradientFlow 32s ease-in-out infinite alternate;\n  border: 1px solid rgba(99, 102, 241, 0.35);\n  box-shadow:\n    0 24px 48px rgba(2, 6, 23, 0.85),\n    0 0 0 1px rgba(99, 102, 241, 0.25) inset;\n  color: var(--color-text);\n}\n\nhtml[data-theme='dark'] .modal-dialog.spg-modal .modal-header,\nhtml[data-theme='dark'] .modal-dialog.spg-modal .modal-footer {\n  border-color: rgba(99, 102, 241, 0.2);\n}\n\nhtml[data-theme='dark'] .spg-modal-summary {\n  background: rgba(99, 102, 241, 0.12);\n  border-color: rgba(99, 102, 241, 0.24);\n}\n\nhtml[data-theme='dark'] .spg-modal-gene-table table,\nhtml[data-theme='dark'] .spg-modal-gene-table th,\nhtml[data-theme='dark'] .spg-modal-gene-table td {\n  color: var(--color-text);\n}\n\nhtml[data-theme='dark'] .spg-modal-gene-table table {\n  background: rgba(12, 18, 35, 0.92);\n  border-color: rgba(99, 102, 241, 0.32);\n}\n\nhtml[data-theme='dark'] .spg-modal-gene-table th {\n  background: rgba(99, 102, 241, 0.24);\n}\n\nhtml[data-theme='dark'] .spg-modal-gene-table tr:nth-child(even) {\n  background: rgba(12, 18, 35, 0.82);\n}\n\nhtml[data-theme='dark'] .spg-modal-gene-table::-webkit-scrollbar-thumb {\n  background: rgba(129, 140, 248, 0.5);\n}\n\nhtml[data-theme='dark'] .spg-modal-search {\n  background: rgba(15, 22, 45, 0.9);\n  border-color: rgba(99, 102, 241, 0.35);\n  color: var(--color-text);\n  box-shadow: inset 0 0 0 1px rgba(99, 102, 241, 0.15);\n}\n\nhtml[data-theme='dark'] .spg-modal-search:focus {\n  border-color: rgba(129, 140, 248, 0.8);\n  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);\n}\n\nhtml[data-theme='dark'] .spg-modal-search-result {\n  color: rgba(129, 140, 248, 0.9);\n}\n\nhtml[data-theme='dark'] .modal-dialog.spg-modal .btn.sp