ass=\"theme-toggle-input\" aria-label=\"Toggle dark mode\"/>\n            <label for=\"theme-toggle\" class=\"theme-toggle-label\" role=\"switch\" aria-hidden=\"true\">\n              <span class=\"theme-toggle-icon\">\n                <i class=\"far fa-sun\" role=\"presentation\" aria-label=\"sun icon\"></i>\n              </span>\n              <span class=\"theme-toggle-track\">\n                <span class=\"theme-toggle-thumb\"></span>\n              </span>\n              <span class=\"theme-toggle-icon\">\n                <i class=\"far fa-moon\" role=\"presentation\" aria-label=\"moon icon\"></i>\n              </span>\n            </label>\n          </div>\n          <a class=\"hdr-logo\" href=\"https://weiyanlab.com\" target=\"_blank\" aria-label=\"Wei Yan Lab website (opens in a new tab)\">\n            <img src=\"logo.png\" alt=\"Wei Yan Lab Logo\"/>\n          </a>\n        </div>\n      </div>\n      <body class=\"bslib-page-navbar\">\n        <nav class=\"navbar navbar-default navbar-static-top\" role=\"navigation\" data-bs-theme=\"light\">\n          <div class=\"container-fluid\">\n            <div class=\"navbar-header\">\n              <span class=\"navbar-brand\"></span>\n            </div>\n            <ul class=\"nav navbar-nav nav-underline shiny-tab-input\" id=\"mainTabs\" data-tabsetid=\"8975\">\n              <li class=\"nav-item\">\n                <a href=\"#tab-8975-1\" data-toggle=\"tab\" data-bs-toggle=\"tab\" data-value=\"home\" class=\"nav-link active\">\n                  <i class=\"fas fa-house\" role=\"presentation\" aria-label=\"house icon\"></i>\n                  Home\n                </a>\n              </li>\n              <li class=\"dropdown nav-item\">\n                <a href=\"#\" class=\"dropdown-toggle nav-link\" data-toggle=\"dropdown\" data-bs-toggle=\"dropdown\" data-value=\"Interactive Data\">\n                  Interactive Data\n                  <b class=\"caret\"></b>\n                </a>\n                <ul class=\"dropdown-menu\" data-tabsetid=\"3690\">\n                  <li>\n                    <a href=\"#tab-3690-1\" data-toggle=\"tab\" data-bs-toggle=\"tab\" data-value=\"spermatogonia_table\" class=\"dropdown-item\">Spermatogenesis Table</a>\n                  </li>\n                  <li>\n                    <a href=\"#tab-3690-2\" data-toggle=\"tab\" data-bs-toggle=\"tab\" data-value=\"retinoic_acid\" class=\"dropdown-item\">Retinoic Acid Analysis</a>\n                  </li>\n                  <li>\n                    <a href=\"#tab-3690-3\" data-toggle=\"tab\" data-bs-toggle=\"tab\" data-value=\"cell2cell_heatmaps\" class=\"dropdown-item\">Cell-to-Cell Heatmap</a>\n                  </li>\n                </ul>\n              </li>\n              <li class=\"dropdown nav-item\">\n                <a href=\"#\" class=\"dropdown-toggle nav-link\" data-toggle=\"dropdown\" data-bs-toggle=\"dropdown\" data-value=\"Staged Testis\">\n                  Staged Testis\n                  <b class=\"caret\"></b>\n                </a>\n                <ul class=\"dropdown-menu\" data-tabsetid=\"2845\">\n                  <li>\n                    <a href=\"#tab-2845-1\" data-toggle=\"tab\" data-bs-toggle=\"tab\" data-value=\"sc3_main_figures\" class=\"dropdown-item\">Main Figures</a>\n                  </li>\n                  <li>\n                    <a href=\"#tab-2845-2\" data-toggle=\"tab\" data-bs-toggle=\"tab\" data-value=\"sc3_cellinfo_gene\" class=\"dropdown-item\">CellInfo vs GeneExpr</a>\n                  </li>\n                  <li>\n                    <a href=\"#tab-2845-3\" data-toggle=\"tab\" data-bs-toggle=\"tab\" data-value=\"sc3_cellinfo_cellinfo\" class=\"dropdown-item\">CellInfo vs CellInfo</a>\n                  </li>\n                  <li>\n                    <a href=\"#tab-2845-4\" data-toggle=\"tab\" data-bs-toggle=\"tab\" data-value=\"sc3_gene_gene\" class=\"dropdown-item\">GeneExpr vs GeneExpr</a>\n                  </li>\n                 