# R / RStudio artifacts
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Large data objects (avoid pushing huge files)
*.rds
*.RDS
*.h5
*.h5ad
*.h5seurat
*.loom
*.qs

# Local / temp files
tmp/
tmp
build.log
rsconnect/
Rplots.pdf

# Backup files
ShinyApp/shinyApp/backupFiles/

# Browser network/profile captures
ShinyApp/shinyApp/www/*.har
ShinyApp/shinyApp/www/*.json.gz
ShinyApp/shinyApp/www/* profile.json/
ShinyApp/shinyApp/archive/network_profiles/*.har
ShinyApp/shinyApp/archive/network_profiles/*.json
ShinyApp/shinyApp/archive/network_profiles/*.json.gz
ShinyApp/shinyApp/archive/network_profiles/* profile.json/

# Secrets (never commit)
.Renviron
.Renviron.*
.Rprofile
.env
.env.*

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.codex
*:Zone.Identifier
ShinyApp/shinyApp/all_figures.pdf
