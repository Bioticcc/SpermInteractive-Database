# R / RStudio artifacts
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Large data objects (avoid pushing huge files)
*.rds
*.RDS
*.h5
*.h5ad
*.h5seurat
*.loom
*.qs

# Runtime/generated app data lives in Data/. Keep the small runtime CellChat CSV
# committable, but leave generated RDS/HDF5 assets and raw Seurat objects local.
ShinyApp/shinyApp/Data/*.rds
ShinyApp/shinyApp/Data/*.RDS
ShinyApp/shinyApp/Data/*.h5
ShinyApp/shinyApp/Data/*.h5ad
ShinyApp/shinyApp/Data/*.h5seurat
ShinyApp/shinyApp/Data/*.loom
ShinyApp/shinyApp/Data/*.qs
ShinyApp/shinyApp/Data/*.RData
!ShinyApp/shinyApp/Data/CellChat_all_stage_communication_score_LR_reverse.csv

# Legacy app-root data locations retained as ignore rules so regenerated assets
# are not accidentally committed outside Data/.
ShinyApp/shinyApp/*.rds
ShinyApp/shinyApp/*.RDS
ShinyApp/shinyApp/*.h5
ShinyApp/shinyApp/*.h5ad
ShinyApp/shinyApp/*.h5seurat
ShinyApp/shinyApp/*.loom
ShinyApp/shinyApp/*.qs
ShinyApp/shinyApp/*.RData

# Local / temp files
tmp/
tmp
build.log
rsconnect/
Rplots.pdf

# Backup files
ShinyApp/shinyApp/backupFiles/

# Browser network/profile captures
ShinyApp/shinyApp/www/*.har
ShinyApp/shinyApp/www/*.json.gz
ShinyApp/shinyApp/www/* profile.json/
ShinyApp/shinyApp/www/archive/network_profiles/*.har
ShinyApp/shinyApp/www/archive/network_profiles/*.json
ShinyApp/shinyApp/www/archive/network_profiles/*.json.gz
ShinyApp/shinyApp/www/archive/network_profiles/* profile.json/

# Secrets (never commit)
.Renviron
.Renviron.*
.Rprofile
.env
.env.*

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.codex
*:Zone.Identifier
ShinyApp/shinyApp/all_figures.pdf

# Generated reference outputs
ShinyApp/shinyApp/www/dotplot_RA_specificCellID.pdf
ShinyApp/shinyApp/www/figure7_C_RA_across_stages.pdf

# Additional files
ShinyApp/shinyApp/www/archive/reference/all_figures.pdf
